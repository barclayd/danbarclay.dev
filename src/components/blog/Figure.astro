---
// Frame for interactive figures and tables: numbered label, body, caption.
interface Props {
  n: string;
  label: string;
  caption?: string;
}
const { n, label, caption } = Astro.props;
---

<figure class="not-prose my-10 border border-[var(--color-rule-strong)] bg-[var(--color-void)]">
  <div class="flex items-baseline gap-2 border-b border-[var(--color-rule)] px-4 py-2.5 font-mono text-[10px] uppercase tracking-hud text-[var(--color-mute)]">
    <span class="shrink-0 text-[var(--color-amber)]">FIG. {n}</span><span aria-hidden="true">·</span><span>{label}</span>
  </div>
  <div class="p-4 sm:p-5"><slot /></div>
  {caption && (
    <figcaption class="border-t border-[var(--color-rule)] px-4 py-3 font-display text-sm leading-relaxed text-[var(--color-mute)]">{caption}</figcaption>
  )}
</figure>
