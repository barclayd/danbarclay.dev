---
/**
 * TweetCard - a single post from the on-site archive.
 *
 * Variants:
 *   - "hero" - the pinned (or latest) post, set larger.
 *   - "row"  - an archive card.
 *
 * The whole card opens the tweet on x.com through a stretched link; links in
 * the text and video controls sit above it so they stay usable. Renders the
 * reply / quote parent inline, linkified text, media, metrics and topics.
 */
import path from "node:path";
import sharp from "sharp";
import type { Tweet } from "../lib/types";

interface Props {
  tweet: Tweet;
  variant?: "hero" | "row";
}

const { tweet, variant = "row" } = Astro.props;
const isHero = variant === "hero";

const date = new Date(tweet.postedAt).toLocaleDateString("en-GB", {
  day: "numeric",
  month: "short",
  year: "numeric",
  timeZone: "UTC",
});

const fmtCount = (n: number) => {
  if (n < 1000) return String(n);
  if (n < 10_000) return (n / 1000).toFixed(1).replace(/\.0$/, "") + "K";
  if (n < 1_000_000) return Math.round(n / 1000) + "K";
  return (n / 1_000_000).toFixed(1).replace(/\.0$/, "") + "M";
};

/* ----- Text rendering - linkify URLs, @mentions, #hashtags, escape HTML ----- */
const escapeHtml = (s: string) =>
  s
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;")
    .replace(/'/g, "&#39;");

// One pass: split on URL / @mention / #hashtag tokens, escape inert text,
// wrap tokens with semantic spans/links.
const renderTweetText = (raw: string): string => {
  const TOKEN = /(https?:\/\/[^\s<>'"]+|@[A-Za-z0-9_]{1,15}|#[A-Za-z][A-Za-z0-9_]{0,99})/g;

  let out = "";
  let i = 0;
  for (const m of raw.matchAll(TOKEN)) {
    const idx = m.index ?? 0;
    if (idx > i) out += escapeHtml(raw.slice(i, idx));
    const tok = m[0];
    if (tok.startsWith("http")) {
      const href = escapeHtml(tok);
      // Display: drop scheme + www. for cleaner reading.
      const display = escapeHtml(tok.replace(/^https?:\/\/(www\.)?/, ""));
      out += `<a class="tw-link" href="${href}" target="_blank" rel="noopener noreferrer">${display}</a>`;
    } else if (tok.startsWith("@")) {
      const handle = tok.slice(1);
      out +=
        `<a class="tw-link" href="https://x.com/${escapeHtml(handle)}" ` +
        `target="_blank" rel="noopener noreferrer">${escapeHtml(tok)}</a>`;
    } else {
      // #hashtag - styled, not linked.
      out += `<span class="tw-hashtag">${escapeHtml(tok)}</span>`;
    }
    i = idx + tok.length;
  }
  if (i < raw.length) out += escapeHtml(raw.slice(i));

  // Preserve newlines.
  return out.replace(/\n/g, "<br/>");
};

const bodyHtml = renderTweetText(tweet.text);

const parent = tweet.replyTo ?? tweet.quoteOf ?? null;
const parentKind = tweet.replyTo ? "Replying to" : "Quoting";
// Images without stored dimensions are measured at build time so the lazy
// loads reserve their space instead of shifting the page.
const media = await Promise.all(
  (tweet.media ?? []).map(async (m) => {
    if (m.type === "video" || (m.width && m.height)) return m;
    try {
      const { width, height } = await sharp(path.join(process.cwd(), "public", m.src)).metadata();
      return { ...m, width, height };
    } catch {
      return m;
    }
  }),
);

const metrics = tweet.metrics
  ? [
      { label: "Likes", value: tweet.metrics.likes },
      { label: "Reposts", value: tweet.metrics.reposts },
      { label: "Replies", value: tweet.metrics.replies },
      ...(tweet.metrics.views != null ? [{ label: "Views", value: tweet.metrics.views }] : []),
    ]
  : [];
---

<article class:list={["tw", isHero && "tw--hero"]}>
  <header class="tw__head">
    <span class="tw__kind">
      <span class="dot tw__dot" aria-hidden="true"></span>
      {isHero ? (tweet.pinned ? "Pinned" : "Latest") : "Post"}
      {tweet.thread && <span class="tw__thread">· Thread {tweet.thread.position}/{tweet.thread.total}</span>}
    </span>
    <time class="tw__date" datetime={tweet.postedAt}>{date}</time>
  </header>

  {
    parent && (
      <blockquote class="tw__parent" cite={parent.url}>
        <span class="tw__parent-by">
          {parentKind} {parent.author} <span class="tw__handle">@{parent.handle}</span>
        </span>
        <p>{parent.text}</p>
      </blockquote>
    )
  }

  <p class="tw__text" set:html={bodyHtml} />

  {
    media.length > 0 && (
      <div class:list={["tw__media", `tw__media--${Math.min(media.length, 4)}`]}>
        {media.map((m, i) =>
          m.type === "video" ? (
            <video src={m.src} poster={m.poster} controls preload="metadata" playsinline width={m.width} height={m.height} />
          ) : (
            <img
              src={m.src}
              alt={m.alt ?? `Image ${i + 1} from the post`}
              loading="lazy"
              decoding="async"
              width={m.width}
              height={m.height}
            />
          ),
        )}
      </div>
    )
  }

  <footer class="tw__foot">
    {
      metrics.length > 0 && (
        <dl class="tw__metrics">
          {metrics.map((m) => (
            <div>
              <dt class="stat-label">{m.label}</dt>
              <dd>{fmtCount(m.value)}</dd>
            </div>
          ))}
        </dl>
      )
    }
    <a class="tw__open" href={tweet.url} target="_blank" rel="noopener noreferrer">
      View on X <span aria-hidden="true">↗</span>
      <span class="sr-only-seo">(post from {date}, opens x.com)</span>
    </a>
  </footer>

  {
    tweet.topics && tweet.topics.length > 0 && (
      <ul class="tw__topics" aria-label="Topics">
        {tweet.topics.map((t) => (
          <li>{t}</li>
        ))}
      </ul>
    )
  }
</article>

<style>
  .tw {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 18px;
    height: 100%;
    padding: clamp(22px, 2.4vw, 32px);
    border: 1px solid var(--color-line-3);
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.015);
    transition:
      border-color 0.4s,
      background-color 0.4s;
  }

  .tw:hover {
    border-color: rgba(255, 255, 255, 0.32);
    background: rgba(255, 255, 255, 0.03);
  }

  .tw:has(.tw__open:focus-visible) {
    outline: 1px solid var(--color-ink);
    outline-offset: 3px;
  }

  .tw__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-label);
  }

  .tw__kind {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }

  .tw__dot {
    width: 6px;
    height: 6px;
  }

  .tw__date {
    font-variant-numeric: tabular-nums;
  }

  .tw__parent {
    margin: 0;
    padding-left: 16px;
    border-left: 1px solid var(--color-line-4);
    font-size: 14px;
    line-height: 1.55;
    color: var(--color-label);
  }

  .tw__parent-by {
    display: block;
    margin-bottom: 4px;
    color: var(--color-muted);
  }

  .tw__handle {
    color: var(--color-label);
  }

  .tw__text {
    font-size: 17px;
    line-height: 1.6;
    color: var(--color-ink-2);
    overflow-wrap: anywhere;
  }

  .tw--hero .tw__text {
    font-size: clamp(20px, 2vw, 28px);
    font-weight: 300;
    line-height: 1.45;
    color: var(--color-ink);
    text-wrap: pretty;
  }

  /* Links, media and video controls sit above the stretched card link. */
  .tw__text :global(.tw-link),
  .tw__media {
    position: relative;
    z-index: 1;
  }

  .tw__text :global(.tw-link) {
    color: var(--color-ink-hi);
    text-decoration: underline;
    text-decoration-color: var(--color-line-4);
    text-underline-offset: 3px;
    transition: text-decoration-color 0.3s;
  }

  .tw__text :global(.tw-link:hover) {
    text-decoration-color: currentColor;
  }

  .tw__text :global(.tw-hashtag) {
    color: var(--color-muted);
  }

  .tw__media {
    display: grid;
    gap: 4px;
    overflow: hidden;
    border-radius: 4px;
  }

  .tw__media--2,
  .tw__media--4 {
    grid-template-columns: 1fr 1fr;
  }

  .tw__media--3 {
    grid-template-columns: 1fr 1fr;
  }

  .tw__media--3 > :first-child {
    grid-column: span 2;
  }

  .tw__media img,
  .tw__media video {
    display: block;
    width: 100%;
    height: 100%;
    max-height: 520px;
    object-fit: cover;
    background: #121418;
  }

  .tw__media:not(.tw__media--1) img,
  .tw__media:not(.tw__media--1) video {
    aspect-ratio: 16 / 10;
  }

  .tw__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px 32px;
    margin-top: auto;
    padding-top: 6px;
  }

  .tw__metrics {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 24px;
  }

  .tw__metrics > div {
    display: flex;
    flex-direction: column-reverse;
    gap: 6px;
  }

  .tw__metrics .stat-label {
    font-size: 10px;
    color: var(--color-label);
  }

  .tw__metrics dd {
    font-stretch: 118%;
    font-weight: 300;
    font-size: 18px;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .tw__open {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-ink-3);
    transition: color 0.3s;
  }

  .tw__open:focus-visible {
    outline: none;
  }

  .tw__open::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .tw:hover .tw__open {
    color: var(--color-ink-hi);
  }

  .tw__topics {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .tw__topics li {
    padding: 4px 10px;
    border: 1px solid var(--color-line-3);
    border-radius: 999px;
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
</style>
