---
import Cta from "./Cta.astro";
import { PRODUCT_LIST } from "../lib/products";

interface Props {
  active?: string;
}

const { active } = Astro.props;

const pages = [
  { key: "about", label: "About", href: "/about" },
  { key: "work", label: "Work", href: "/work" },
];

const menu = [
  { key: "home", label: "Home", tag: "Index", href: "/" },
  { key: "about", label: "About", tag: "Bio", href: "/about" },
  { key: "work", label: "Work", tag: "Projects", href: "/work" },
  ...PRODUCT_LIST.map((p) => ({ key: p.key as string, label: p.name, tag: p.navTag, href: p.href, accent: p.accent })),
];
---

<header class="nav" data-nav>
  <div class="nav__bar">
    <a href="/" class="nav__logo" aria-label="Dan Barclay, home">DAN BARCLAY</a>
    <nav aria-label="Primary" class="nav__links">
      {
        pages.map((l) => (
          <a href={l.href} class="nav__link" aria-current={active === l.key ? "page" : undefined}>
            {l.label}
          </a>
        ))
      }
      <span class="nav__divider" aria-hidden="true"></span>
      {
        PRODUCT_LIST.map((p) => (
          <a href={p.href} class="nav__link" style={`--accent:${p.accent}`} aria-current={active === p.key ? "page" : undefined}>
            <span class="nav__dot" aria-hidden="true" />
            {p.name}
          </a>
        ))
      }
    </nav>
    <Cta size="sm" enquire class="nav__cta">Work with me</Cta>
    <button type="button" class="nav__toggle" aria-expanded="false" aria-controls="site-menu" data-nav-toggle>Menu</button>
  </div>
</header>

<div id="site-menu" class="menu" hidden data-nav-menu>
  <nav aria-label="Mobile" class="menu__list">
    {
      menu.map((m, i) => (
        <a
          href={m.href}
          class="menu__row"
          data-menu-row
          aria-current={active === m.key ? "page" : undefined}
          style={m.accent ? `--accent:${m.accent}` : undefined}
        >
          <span class="menu__name">
            <span class="menu__n">{String(i + 1).padStart(2, "0")}</span>
            <span class="menu__label">{m.label}</span>
          </span>
          <span class="menu__tag">
            {m.accent && <span class="menu__dot" aria-hidden="true" />}
            {m.tag}
          </span>
        </a>
      ))
    }
  </nav>
  <Cta enquire class="menu__cta" data-menu-row>Work with me</Cta>
</div>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 60;
    transition: transform 0.8s var(--ease-out-expo);
  }

  .nav.is-hidden {
    transform: translate3d(0, -100%, 0);
  }

  .nav__bar {
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 0 max(clamp(20px, 3vw, 44px), env(safe-area-inset-right)) 0 max(clamp(20px, 3vw, 44px), env(safe-area-inset-left));
    border-bottom: 1px solid transparent;
    transition:
      background-color 0.5s,
      border-color 0.5s,
      backdrop-filter 0.5s;
  }

  .nav.is-scrolled .nav__bar,
  .nav.is-open .nav__bar {
    background: rgba(8, 9, 11, 0.72);
  }

  .nav.is-scrolled .nav__bar {
    -webkit-backdrop-filter: blur(20px) saturate(140%);
    backdrop-filter: blur(20px) saturate(140%);
    border-bottom-color: var(--color-line-1);
  }

  .nav.is-open .nav__bar {
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
    border-bottom-color: transparent;
  }

  .nav__logo {
    font-family: var(--font-display);
    font-size: 13px;
    letter-spacing: 0.34em;
    white-space: nowrap;
    padding: 8px 0;
  }

  .nav__links {
    display: flex;
    align-items: center;
    gap: 2px;
  }

  .nav__link {
    position: relative;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 14px;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 550;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-ink-3);
    white-space: nowrap;
    transition:
      background-color 0.3s,
      color 0.3s;
  }

  .nav__link:hover {
    background: rgba(255, 255, 255, 0.07);
    color: var(--color-ink-hi);
  }

  .nav__link[aria-current="page"]::after {
    content: "";
    position: absolute;
    left: 14px;
    right: 14px;
    bottom: 3px;
    height: 1px;
    background: var(--accent, var(--color-ink));
  }

  .nav__dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent);
  }

  .nav__divider {
    width: 1px;
    height: 16px;
    background: var(--color-line-4);
    margin: 0 8px;
  }

  .nav__toggle {
    height: 36px;
    padding: 0 16px;
    border-radius: 4px;
    border: 0;
    background: rgba(255, 255, 255, 0.09);
    color: var(--color-ink);
    font: inherit;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background-color 0.3s;
  }

  .nav__toggle:hover {
    background: rgba(255, 255, 255, 0.16);
  }

  /* Below the width the full link row needs, the bar collapses to a menu. */
  @media (max-width: 1099px) {
    .nav__links,
    .nav :global(.nav__cta) {
      display: none;
    }
  }

  @media (min-width: 1100px) {
    .nav__toggle,
    .menu {
      display: none !important;
    }
  }

  .menu {
    position: fixed;
    inset: 0;
    z-index: 58;
    background: var(--color-bg);
    padding: 96px max(clamp(20px, 6vw, 40px), env(safe-area-inset-right)) max(32px, env(safe-area-inset-bottom))
      max(clamp(20px, 6vw, 40px), env(safe-area-inset-left));
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 40px;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .menu[hidden] {
    display: none;
  }

  .menu__list {
    display: flex;
    flex-direction: column;
  }

  .menu__row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    padding: 18px 0;
    border-bottom: 1px solid var(--color-line-2);
  }

  .menu__name {
    display: flex;
    align-items: baseline;
    gap: 16px;
  }

  .menu__n {
    font-size: 11px;
    color: var(--color-label);
    letter-spacing: 0.1em;
    font-variant-numeric: tabular-nums;
  }

  .menu__label {
    font-family: var(--font-display);
    font-size: 22px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .menu__row[aria-current="page"] .menu__label {
    color: var(--accent, var(--color-ink));
  }

  .menu__tag {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-label);
  }

  .menu__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }

  .menu :global(.menu__cta) {
    width: 100%;
    flex: none;
  }
</style>

<script>
  const root = document.documentElement;
  const header = document.querySelector<HTMLElement>("[data-nav]")!;
  const toggle = header.querySelector<HTMLButtonElement>("[data-nav-toggle]")!;
  const menu = document.querySelector<HTMLElement>("[data-nav-menu]")!;
  const rows = [...menu.querySelectorAll<HTMLElement>("[data-menu-row]")];
  const reduced = matchMedia("(prefers-reduced-motion: reduce)");
  const EASE = "cubic-bezier(0.16, 1, 0.3, 1)";

  let lastY = Math.max(0, scrollY);
  let hidden = false;

  const locked = () => root.classList.contains("menu-open") || root.classList.contains("enquiry-open");

  function update() {
    const y = Math.max(0, scrollY);
    if (y < 240) hidden = false;
    else if (Math.abs(y - lastY) > 4) hidden = y > lastY;
    if (Math.abs(y - lastY) > 4 || y < 240) lastY = y;
    header.classList.toggle("is-hidden", hidden && !locked());
    header.classList.toggle("is-scrolled", y > 24);
  }

  function setMenu(open: boolean) {
    if (open === root.classList.contains("menu-open")) return;
    root.classList.toggle("menu-open", open);
    header.classList.toggle("is-open", open);
    toggle.setAttribute("aria-expanded", String(open));
    toggle.textContent = open ? "Close" : "Menu";
    menu.hidden = !open;
    update();
    if (!open || reduced.matches) return;
    rows.forEach((r, i) =>
      r.animate(
        [
          { opacity: 0, transform: "translate3d(0,40px,0)", filter: "blur(10px)" },
          { opacity: 1, transform: "translate3d(0,0,0)", filter: "blur(0px)" },
        ],
        { duration: 1000, delay: i === rows.length - 1 ? 450 : i * 55, easing: EASE, fill: "backwards" },
      ),
    );
  }

  toggle.addEventListener("click", () => setMenu(!root.classList.contains("menu-open")));
  addEventListener("keydown", (e) => {
    if (e.key === "Escape" && root.classList.contains("menu-open")) {
      setMenu(false);
      toggle.focus();
    }
  });
  // The enquiry dialog takes over from the menu.
  addEventListener("db:enquire", () => setMenu(false));
  matchMedia("(min-width: 1100px)").addEventListener("change", (e) => e.matches && setMenu(false));
  // A bfcache restore should never come back with the menu open.
  addEventListener("pageshow", (e) => e.persisted && setMenu(false));
  addEventListener("scroll", update, { passive: true });
  update();
</script>
