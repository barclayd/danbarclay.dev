<script>
  // Lazy-load Spotify iframes on first open of a row, and wire up the
  // expand/collapse toggle + copy-link CTAs.
  (function () {
    const pods = document.querySelectorAll<HTMLElement>("[data-pod]");
    pods.forEach((pod) => {
      const toggle = pod.querySelector<HTMLButtonElement>("[data-pod-toggle]");
      const shell = pod.querySelector<HTMLElement>("[data-pod-shell]");
      const iframe = pod.querySelector<HTMLIFrameElement>("iframe[data-lazy]");
      const label = pod.querySelector<HTMLElement>("[data-pod-label]");

      const setOpen = (open: boolean) => {
        pod.dataset.open = open ? "true" : "false";
        if (toggle) toggle.setAttribute("aria-expanded", String(open));
        if (label) label.textContent = open ? "STOP" : "PLAY";
        // Inject the iframe src on first open to avoid loading
        // Spotify chunks until requested.
        if (open && iframe && iframe.dataset.src) {
          iframe.src = iframe.dataset.src;
          delete iframe.dataset.src;
        }
      };

      if (toggle && shell) {
        toggle.addEventListener("click", () => {
          const open = pod.dataset.open !== "true";
          setOpen(open);
        });
      }
    });

    // Copy-link buttons (used on the hero card).
    const copyBtns = document.querySelectorAll<HTMLButtonElement>("[data-copy]");
    copyBtns.forEach((btn) => {
      const url = btn.dataset.copy;
      const label = btn.querySelector<HTMLElement>("[data-copy-label]");
      const originalLabel = label?.textContent ?? "";
      btn.addEventListener("click", async () => {
        if (!url) return;
        try {
          await navigator.clipboard.writeText(url);
          btn.dataset.state = "copied";
          if (label) label.textContent = "LINK COPIED";
          window.setTimeout(() => {
            delete btn.dataset.state;
            if (label) label.textContent = originalLabel;
          }, 1600);
        } catch {
          // Fallback - show a brief failure state.
          if (label) label.textContent = "PRESS ⌘C";
          window.setTimeout(() => {
            if (label) label.textContent = originalLabel;
          }, 1600);
        }
      });
    });
  })();
</script>
