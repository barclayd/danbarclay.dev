---
/**
 * PodcastCard - one podcast appearance.
 *
 * Variants:
 *   - "hero" - artwork, episode details and the Spotify player inline.
 *   - "row"  - an archive row that expands to a player. The embed only loads
 *              on first open; without JS the row still links out to Spotify.
 */
import Cta from "./Cta.astro";
import type { Podcast } from "../lib/types";

interface Props {
  podcast: Podcast;
  variant?: "hero" | "row";
}

const { podcast, variant = "row" } = Astro.props;
const isHero = variant === "hero";

const date = new Date(`${podcast.publishedAt}T00:00:00Z`).toLocaleDateString("en-GB", {
  day: "numeric",
  month: "short",
  year: "numeric",
  timeZone: "UTC",
});
const minutes = `${Math.round(podcast.durationSeconds / 60)} min`;
const idx = String(podcast.index).padStart(2, "0");
const embedAllow = "autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture";
---

{
  isHero ? (
    <article class="pod" id={podcast.slug}>
      <div class="pod__top">
        <div class="pod__art" data-reveal="wipe">
          <img src={podcast.artworkUrl} alt={`${podcast.show} artwork`} width="640" height="640" decoding="async" />
        </div>
        <div class="pod__text">
          <span class="stat-label pod__meta" data-reveal="up">
            Episode {idx} · {date} · {minutes}
          </span>
          <h2 class="pod__title" data-reveal="up">
            {podcast.title}
          </h2>
          <dl class="pod__attrib" data-stagger="80">
            <div data-reveal="up">
              <dt class="stat-label">Show</dt>
              <dd>{podcast.show}</dd>
            </div>
            <div data-reveal="up">
              <dt class="stat-label">Host</dt>
              <dd>{podcast.showHost}</dd>
            </div>
            <div data-reveal="up">
              <dt class="stat-label">Role</dt>
              <dd>{podcast.role}</dd>
            </div>
          </dl>
          <p class="body pod__desc" data-reveal="up">
            {podcast.description}
          </p>
          {podcast.quote && (
            <blockquote class="pod__quote" data-reveal="up">
              {podcast.quote}
            </blockquote>
          )}
          {podcast.topics.length > 0 && (
            <ul class="pod__topics" aria-label="Topics" data-reveal="up">
              {podcast.topics.map((t) => (
                <li>{t}</li>
              ))}
            </ul>
          )}
        </div>
      </div>

      <div class="pod__player" data-reveal="up">
        <iframe src={podcast.embedUrl} title={`Spotify player: ${podcast.title}`} loading="lazy" allow={embedAllow} />
      </div>

      <div class="cta-row" data-stagger="90">
        <Cta href={podcast.spotifyUrl} external data-reveal="up">
          Listen on Spotify
        </Cta>
        {podcast.showUrl && (
          <Cta href={podcast.showUrl} external variant="secondary" data-reveal="up">
            The show
          </Cta>
        )}
      </div>
    </article>
  ) : (
    <details class="row" id={podcast.slug} data-pod>
      <summary class="row__head">
        <span class="row__idx" aria-hidden="true">
          {idx}
        </span>
        <img class="row__thumb" src={podcast.artworkUrl} alt="" width="64" height="64" loading="lazy" decoding="async" />
        <span class="row__text">
          <span class="stat-label row__meta">
            {podcast.show} · {date} · {minutes}
          </span>
          <span class="row__title">{podcast.title}</span>
        </span>
        <span class="row__plus" aria-hidden="true">
          +
        </span>
      </summary>
      <div class="row__body">
        <p class="body">{podcast.description}</p>
        <div class="pod__player">
          <iframe data-src={podcast.embedUrl} title={`Spotify player: ${podcast.title}`} allow={embedAllow} />
        </div>
        <div class="cta-row">
          <Cta href={podcast.spotifyUrl} external size="sm">
            Open on Spotify
          </Cta>
          {podcast.showUrl && (
            <Cta href={podcast.showUrl} external variant="secondary" size="sm">
              The show
            </Cta>
          )}
        </div>
      </div>
    </details>
  )
}

<script>
  // Load each archive row's Spotify embed the first time it opens.
  document.querySelectorAll<HTMLDetailsElement>("details[data-pod]").forEach((row) => {
    row.addEventListener("toggle", () => {
      const frame = row.querySelector<HTMLIFrameElement>("iframe[data-src]");
      if (!row.open || !frame) return;
      frame.src = frame.dataset.src!;
      frame.removeAttribute("data-src");
    });
  });
</script>

<style>
  /* Clear the fixed nav when arriving via a /podcasts#slug link. */
  .pod,
  .row {
    scroll-margin-top: 96px;
  }

  /* ---- Hero ---- */
  .pod {
    display: flex;
    flex-direction: column;
    gap: 40px;
    max-width: 1200px;
  }

  .pod__top {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 40px clamp(40px, 5vw, 80px);
  }

  .pod__art {
    position: relative;
    flex: 0 0 auto;
    width: min(320px, 100%);
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 4px;
    background: #121418;
  }

  .pod__art img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.05);
  }

  .pod__text {
    flex: 1 1 460px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
  }

  .pod__meta {
    font-size: 12px;
    line-height: 1.6;
  }

  .pod__title {
    margin: 0;
    font-stretch: 115%;
    font-weight: 300;
    font-size: clamp(26px, 3vw, 44px);
    line-height: 1.12;
    color: var(--color-ink-hi);
    text-wrap: balance;
  }

  .pod__attrib {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 40px;
  }

  .pod__attrib > div {
    display: flex;
    flex-direction: column-reverse;
    gap: 6px;
  }

  .pod__attrib dd {
    font-size: 16px;
    color: var(--color-ink);
  }

  .pod__desc {
    max-width: 680px;
    font-size: 16px;
    line-height: 1.65;
    text-wrap: pretty;
  }

  .pod__quote {
    margin: 0;
    padding-left: 20px;
    border-left: 1px solid var(--color-line-4);
    font-size: clamp(18px, 1.6vw, 22px);
    font-weight: 300;
    line-height: 1.5;
    color: var(--color-ink);
  }

  .pod__topics {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .pod__topics li {
    padding: 4px 10px;
    border: 1px solid var(--color-line-3);
    border-radius: 999px;
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .pod__player {
    overflow: hidden;
    border-radius: 12px;
    background: #121418;
  }

  .pod__player iframe {
    display: block;
    width: 100%;
    height: 152px;
    border: 0;
  }

  /* ---- Archive row ---- */
  .row {
    border-bottom: 1px solid var(--color-line-2);
    interpolate-size: allow-keywords;
  }

  .row__head {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 22px 0;
    cursor: pointer;
    list-style: none;
  }

  .row__head::-webkit-details-marker {
    display: none;
  }

  .row__idx {
    flex: none;
    font-size: 12px;
    letter-spacing: 0.1em;
    color: var(--color-label);
    font-variant-numeric: tabular-nums;
  }

  .row__thumb {
    flex: none;
    width: 64px;
    height: 64px;
    border-radius: 4px;
    object-fit: cover;
    filter: grayscale(1) contrast(1.05);
  }

  .row__text {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .row__title {
    font-size: clamp(17px, 1.5vw, 21px);
    font-weight: 450;
    line-height: 1.35;
    color: var(--color-ink);
  }

  .row__plus {
    flex: none;
    font-size: 22px;
    font-weight: 200;
    line-height: 1;
    transition: rotate 0.5s var(--ease-out-expo);
  }

  .row[open] .row__plus {
    rotate: 45deg;
  }

  .row::details-content {
    block-size: 0;
    overflow-y: clip;
    transition:
      block-size 0.6s var(--ease-out-expo),
      content-visibility 0.6s allow-discrete;
  }

  .row[open]::details-content {
    block-size: auto;
  }

  .row__body {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 0 0 28px 84px;
  }

  @media (prefers-reduced-motion: reduce) {
    .row__plus,
    .row::details-content {
      transition: none;
    }
  }

  @media (max-width: 639px) {
    .pod {
      gap: 32px;
    }

    .pod__art {
      width: min(220px, 100%);
    }

    .row__idx {
      display: none;
    }

    .row__head {
      gap: 14px;
    }

    .row__thumb {
      width: 52px;
      height: 52px;
    }

    .row__body {
      padding-left: 0;
    }
  }
</style>
