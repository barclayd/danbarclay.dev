---
import CornerBrackets from "./CornerBrackets.astro";

interface Props {
  label?: string;
  index?: string;
  bracketSize?: number;
  bracketColor?: string;
  className?: string;
  as?: keyof HTMLElementTagNameMap;
}

const {
  label,
  index,
  bracketSize = 14,
  bracketColor = "var(--color-amber)",
  className = "",
  as: Tag = "section",
} = Astro.props;
---

<Tag class:list={["hud-frame relative", className]}>
  <CornerBrackets size={bracketSize} color={bracketColor} />
  {
    (label || index) && (
      <div class="absolute -top-2 left-6 right-6 flex items-center justify-between gap-3 pointer-events-none z-10">
        {label && (
          <span class="bg-[var(--color-void)] px-2 py-0.5 font-mono text-[10px] uppercase tracking-hud text-[var(--color-mute)]">
            {label}
          </span>
        )}
        {index && (
          <span class="bg-[var(--color-void)] px-2 py-0.5 font-mono text-[10px] uppercase tracking-hud text-[var(--color-amber)]">
            {index}
          </span>
        )}
      </div>
    )
  }
  <slot />
</Tag>

<style>
  .hud-frame {
    border: 1px solid var(--color-rule);
    background: linear-gradient(
      180deg,
      rgba(20, 24, 28, 0.6) 0%,
      rgba(14, 17, 20, 0.6) 100%
    );
    backdrop-filter: blur(0.5px);
  }
</style>
