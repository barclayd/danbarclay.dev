---
import HudFrame from "./HudFrame.astro";

const socials = [
  { code: "GH/barclayd", label: "GITHUB", href: "https://github.com/barclayd" },
  { code: "X/danielbarclay", label: "TWITTER · X", href: "https://x.com/danielbarclay" },
  { code: "LI/barclayd", label: "LINKEDIN", href: "https://www.linkedin.com/in/barclayd/" },
  { code: "MAIL/barclysd@me.com", label: "EMAIL", href: "mailto:barclysd@me.com" },
];

const buildDate = new Date().toISOString();
const buildLabel =
  buildDate.slice(0, 10).replace(/-/g, ".") +
  " " +
  buildDate.slice(11, 16) +
  " UTC";
const sha = (Math.random().toString(16) + "0000000").slice(2, 9); // placeholder; replaced at build if GIT_SHA env present
const gitSha = (import.meta as any).env?.GIT_SHA ?? sha;
---

<HudFrame
  label="C/03 // COMMS · OUTBOUND CHANNELS"
  index="OPEN"
  className="px-6 py-10 sm:px-10 sm:py-14 panel-reveal"
>
  <div class="flex flex-wrap items-baseline justify-between gap-4">
    <h2 class="font-display text-2xl font-semibold uppercase tracking-tight text-[var(--color-text-bright)] sm:text-3xl">
      Establish / Contact
    </h2>
    <div class="font-mono text-[10px] uppercase tracking-hud text-[var(--color-mute)]">
      RESPONSE WINDOW · 24–72H
    </div>
  </div>

  <div class="my-8 h-px w-full bg-[var(--color-rule)]"></div>

  <div class="grid grid-cols-1 gap-px bg-[var(--color-rule)] sm:grid-cols-2">
    {
      socials.map((s) => (
        <a
          href={s.href}
          target={s.href.startsWith("http") ? "_blank" : undefined}
          rel={s.href.startsWith("http") ? "noopener noreferrer" : undefined}
          class="group relative flex items-center justify-between gap-4 bg-[var(--color-void)] px-5 py-6 transition-colors hover:bg-[rgba(232,154,60,0.04)]"
        >
          <div class="flex flex-col">
            <span class="font-mono text-[10px] uppercase tracking-hud text-[var(--color-mute)]">
              {s.label}
            </span>
            <span class="mt-1 font-display text-lg uppercase tracking-tight text-[var(--color-text-bright)] group-hover:text-[var(--color-amber-glow)]">
              {s.code}
            </span>
          </div>
          <span
            class="font-mono text-2xl text-[var(--color-mute)] transition-transform group-hover:translate-x-1 group-hover:text-[var(--color-amber)]"
            aria-hidden="true"
          >
            ↗
          </span>
        </a>
      ))
    }
  </div>

  <!-- Build metadata footer -->
  <div
    class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-2 border-t border-[var(--color-rule)] pt-4 font-mono text-[10px] uppercase tracking-hud text-[var(--color-mute)]"
  >
    <span>BUILD {gitSha}</span>
    <span>DEPLOYED {buildLabel}</span>
    <span class="ml-auto">DAN BARCLAY / MMXXVI / NO COOKIES · NO TRACKING</span>
  </div>
</HudFrame>
