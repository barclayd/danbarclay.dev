---
import HudFrame from "./HudFrame.astro";
import ScrambleText from "./ScrambleText.tsx";

const socials = [
  { code: "GH/barclayd", label: "GITHUB", href: "https://github.com/barclayd" },
  { code: "X/danielbarclay", label: "TWITTER · X", href: "https://x.com/danielbarclay" },
  { code: "LI/barclayd", label: "LINKEDIN", href: "https://www.linkedin.com/in/barclayd/" },
  { code: "MAIL/barclaysd@me.com", label: "EMAIL", href: "mailto:barclaysd@me.com" },
];

const buildDate = new Date().toISOString();
const buildLabel =
  buildDate.slice(0, 10).replace(/-/g, ".") +
  " " +
  buildDate.slice(11, 16) +
  " UTC";
const sha = (Math.random().toString(16) + "0000000").slice(2, 9); // placeholder; replaced at build if GIT_SHA env present
const gitSha = (import.meta as any).env?.GIT_SHA ?? sha;
---

<HudFrame
  label="CONTACT"
  index="OPEN"
  className="px-6 py-10 sm:px-10 sm:py-14 panel-reveal"
>
  <div class="flex flex-wrap items-baseline justify-between gap-4">
    <div>
      <h2 class="font-display text-2xl font-semibold uppercase tracking-tight text-[var(--color-text-bright)] sm:text-3xl">
        <ScrambleText client:visible text="CONTACT" duration={900} />
      </h2>
      <p class="mt-2 max-w-xl font-mono text-[11px] uppercase tracking-hud text-[var(--color-mute)]">
        <ScrambleText
          client:visible
          text="MOTIVATED BY HARD PROBLEMS AND THE PEOPLE DRIVEN TO SOLVE THEM."
          duration={1100}
          delay={180}
        />
      </p>
    </div>
    <div class="font-mono text-[10px] uppercase tracking-hud text-[var(--color-mute)]">
      RESPONSE WINDOW · 24–72H
    </div>
  </div>

  <div class="my-8 h-px w-full bg-[var(--color-rule)] rule-draw"></div>

  <div class="grid grid-cols-1 gap-px bg-[var(--color-rule)] sm:grid-cols-2 cascade-children">
    {
      socials.map((s) => (
        <a
          href={s.href}
          target={s.href.startsWith("http") ? "_blank" : undefined}
          rel={s.href.startsWith("http") ? "noopener noreferrer" : undefined}
          class="group relative flex min-h-[64px] items-center justify-between gap-4 bg-[var(--color-void)] px-4 py-5 transition-colors hover:bg-[rgba(232,154,60,0.04)] active:bg-[rgba(232,154,60,0.08)] sm:min-h-[88px] sm:px-5 sm:py-7"
        >
          <div class="flex min-w-0 flex-col">
            <span class="font-mono text-[10px] uppercase tracking-hud text-[var(--color-mute)]">
              {s.label}
            </span>
            <span class="mt-1 truncate font-display text-base uppercase tracking-tight text-[var(--color-text-bright)] group-hover:text-[var(--color-amber-glow)] group-active:text-[var(--color-amber-glow)] sm:text-lg">
              {s.code}
            </span>
          </div>
          <span
            class="shrink-0 font-mono text-xl text-[var(--color-mute)] transition-transform group-hover:translate-x-1 group-hover:text-[var(--color-amber)] group-active:text-[var(--color-amber)] sm:text-2xl"
            aria-hidden="true"
          >
            ↗
          </span>
        </a>
      ))
    }
  </div>

  <!-- Build metadata footer -->
  <div
    class="mt-10 flex flex-wrap items-center gap-x-4 gap-y-2 border-t border-[var(--color-rule)] pt-4 font-mono text-[10px] uppercase tracking-hud text-[var(--color-mute)] sm:gap-x-6"
  >
    <span>BUILD {gitSha}</span>
    <span>DEPLOYED {buildLabel}</span>
    <a href="/about" class="sm:ml-auto hover:text-[var(--color-amber-glow)]">
      ABOUT DAN BARCLAY <span aria-hidden="true">↗</span>
    </a>
  </div>
</HudFrame>
