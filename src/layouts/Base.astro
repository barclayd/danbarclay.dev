---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  pageType?: "ProfilePage" | "AboutPage" | "CollectionPage" | "WebPage";
  noPersonGraph?: boolean;
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  breadcrumbs?: Array<{ name: string; url?: string }>;
}

const SITE_URL = "https://danbarclay.dev";

const {
  title = "Dan Barclay - Engineering Leader, Founder, London",
  description = "Dan Barclay is an engineering leader and founder based in London, focused on building Promptly - the CMS powering the next wave of AI development - and KeepFresh - an iOS app working to end food waste for good. 10+ years shipping product and AI experiences to millions.",
  ogImage = "/og.png",
  pageType = "WebPage",
  noPersonGraph = false,
  noindex = false,
  jsonLd,
  breadcrumbs,
} = Astro.props;

// With `build.format: 'file'` the build-time pathname is "/about.html";
// canonical URLs are the extensionless form ("/about", "/" for the index).
const canonicalPath =
  Astro.url.pathname.replace(/\.html$/, "").replace(/\/index$/, "/") || "/";
const canonicalUrl = new URL(canonicalPath, SITE_URL).toString();
const ogImageUrl = new URL(ogImage, SITE_URL).toString();
const profileImageUrl = new URL("/dan-barclay.webp", SITE_URL).toString();

// Core knowledge-graph object: ProfilePage + Person + WebSite.
// Sub-pages (about/work/projects) can pass `noPersonGraph: true` to avoid
// duplicating the Person node, and instead reference @id "https://danbarclay.dev/#person"
// from their own page-level JSON-LD via the `jsonLd` prop.
const personGraph = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": pageType,
      "@id": canonicalUrl + "#page",
      url: canonicalUrl,
      name: title,
      description,
      inLanguage: "en-GB",
      isPartOf: { "@id": SITE_URL + "/#website" },
      ...(pageType === "ProfilePage"
        ? { mainEntity: { "@id": SITE_URL + "/#person" } }
        : { about: { "@id": SITE_URL + "/#person" } }),
      primaryImageOfPage: { "@id": SITE_URL + "/#og-image" },
    },
    {
      "@type": "ImageObject",
      "@id": SITE_URL + "/#og-image",
      url: ogImageUrl,
      contentUrl: ogImageUrl,
      width: 1200,
      height: 630,
      caption: "Dan Barclay - Engineering Leader",
    },
    {
      "@type": "WebSite",
      "@id": SITE_URL + "/#website",
      url: SITE_URL + "/",
      name: "Dan Barclay",
      description: "Personal site of Dan Barclay - engineering leader and founder in London.",
      inLanguage: "en-GB",
      publisher: { "@id": SITE_URL + "/#person" },
      author: { "@id": SITE_URL + "/#person" },
    },
    {
      "@type": "Person",
      "@id": SITE_URL + "/#person",
      name: "Dan Barclay",
      givenName: "Dan",
      familyName: "Barclay",
      alternateName: ["Daniel Barclay", "barclayd"],
      jobTitle: "Engineering Lead",
      description:
        "Engineering leader, full-stack product engineer and founder with 10+ years building software for millions of users. Focused on building Promptly - the CMS powering the next wave of AI development - and KeepFresh, an iOS app working to end food waste for good. Based in London, UK.",
      url: SITE_URL + "/",
      mainEntityOfPage: { "@id": SITE_URL + "/#page" },
      image: {
        "@type": "ImageObject",
        url: profileImageUrl,
        contentUrl: profileImageUrl,
        caption: "Dan Barclay",
      },
      address: {
        "@type": "PostalAddress",
        addressLocality: "London",
        addressCountry: "GB",
      },
      nationality: { "@type": "Country", name: "United Kingdom" },
      knowsAbout: [
        "Software Engineering",
        "Engineering Leadership",
        "Product Engineering",
        "TypeScript",
        "React",
        "Node.js",
        "Python",
        "Rust",
        "Swift",
        "iOS Development",
        "Large Language Models",
        "Model Context Protocol",
        "AI Product Design",
        "B2B SaaS",
      ],
      sameAs: [
        "https://github.com/barclayd",
        "https://x.com/danielbarclay",
        "https://www.linkedin.com/in/barclayd/",
        "https://stackoverflow.com/users/9961739/dan-barclay",
        "https://promptlycms.com",
        "https://keepfre.sh",
      ],
      founder: [
        {
          "@type": "SoftwareApplication",
          name: "Promptly",
          url: "https://promptlycms.com",
          applicationCategory: "DeveloperApplication",
        },
        {
          "@type": "MobileApplication",
          name: "KeepFresh",
          url: "https://keepfre.sh",
          applicationCategory: "LifestyleApplication",
        },
      ],
    },
  ],
};

// BreadcrumbList - emitted only when the page declares a trail. The final
// item omits `item` per Google guidance, so the trail terminator isn't a
// self-link to the current page.
const breadcrumbJsonLd =
  breadcrumbs && breadcrumbs.length > 0
    ? {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "@id": canonicalUrl + "#breadcrumbs",
        itemListElement: breadcrumbs.map((b, i) => ({
          "@type": "ListItem",
          position: i + 1,
          name: b.name,
          ...(b.url ? { item: new URL(b.url, SITE_URL).toString() } : {}),
        })),
      }
    : null;

const extraJsonLd = Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : [];
const graphsToEmit = [
  ...(noPersonGraph ? [] : [personGraph]),
  ...(breadcrumbJsonLd ? [breadcrumbJsonLd] : []),
  ...extraJsonLd,
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Primary -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="author" content="Dan Barclay" />
    <meta name="creator" content="Dan Barclay" />
    <meta name="publisher" content="Dan Barclay" />
    <meta name="theme-color" content="#0E1114" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />

    <!-- Open Graph -->
    <meta property="og:type" content={pageType === "ProfilePage" ? "profile" : "website"} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Dan Barclay" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Dan Barclay - Engineering Leader, Founder, London" />
    {pageType === "ProfilePage" && (
      <>
        <meta property="profile:first_name" content="Dan" />
        <meta property="profile:last_name" content="Barclay" />
        <meta property="profile:username" content="barclayd" />
      </>
    )}

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content="Dan Barclay - Engineering Leader, Founder, London" />
    <meta name="twitter:site" content="@danielbarclay" />
    <meta name="twitter:creator" content="@danielbarclay" />

    <!-- IndieWeb rel=me - links this site to other profiles in the identity graph. -->
    <link rel="me" href="https://github.com/barclayd" />
    <link rel="me" href="https://x.com/danielbarclay" />
    <link rel="me" href="https://www.linkedin.com/in/barclayd/" />
    <link rel="me" href="mailto:barclaysd@me.com" />

    <!-- Robots: maximise indexing + snippet richness for AI overviews. -->
    {noindex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <>
        <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
        <meta name="googlebot" content="index, follow, max-snippet:-1, max-image-preview:large" />
      </>
    )}

    <!-- Structured data - the heart of the LLM/Knowledge-Graph signal. -->
    {graphsToEmit.length > 0 && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(graphsToEmit.length === 1 ? graphsToEmit[0] : graphsToEmit)}
      />
    )}
  </head>
  <body>
    <div class="boot-scanline" aria-hidden="true"></div>
    <div id="scroll-progress" class="scroll-progress" aria-hidden="true"></div>
    <div id="cursor-glow" class="cursor-glow" aria-hidden="true"></div>
    <slot />

    <script is:inline>
      // Scroll progress bar - fixed 1px amber line at the top of the viewport.
      (function () {
        const bar = document.getElementById("scroll-progress");
        if (!bar) return;
        let ticking = false;
        function update() {
          const doc = document.documentElement;
          const max = Math.max(1, doc.scrollHeight - doc.clientHeight);
          const pct = Math.min(1, Math.max(0, window.scrollY / max));
          bar.style.transform = "scaleX(" + pct + ")";
          ticking = false;
        }
        window.addEventListener(
          "scroll",
          function () {
            if (!ticking) {
              window.requestAnimationFrame(update);
              ticking = true;
            }
          },
          { passive: true }
        );
        update();
      })();

      // Cursor radial glow - pointer-tracked amber spotlight (mouse only).
      (function () {
        const glow = document.getElementById("cursor-glow");
        if (!glow) return;
        if (window.matchMedia("(pointer: coarse)").matches) return;
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        let x = -9999,
          y = -9999,
          tx = -9999,
          ty = -9999,
          raf = 0;
        function tick() {
          x += (tx - x) * 0.18;
          y += (ty - y) * 0.18;
          glow.style.transform =
            "translate3d(" + x + "px," + y + "px,0) translate(-50%,-50%)";
          raf = requestAnimationFrame(tick);
        }
        window.addEventListener(
          "pointermove",
          function (e) {
            if (e.pointerType && e.pointerType !== "mouse") return;
            tx = e.clientX;
            ty = e.clientY;
            if (!raf) {
              x = tx;
              y = ty;
              glow.style.opacity = "1";
              raf = requestAnimationFrame(tick);
            }
          },
          { passive: true }
        );
        window.addEventListener("pointerleave", function () {
          glow.style.opacity = "0";
        });
      })();
    </script>
  </body>
</html>
