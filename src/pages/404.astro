---
import Base from "../layouts/Base.astro";
import Cta from "../components/Cta.astro";
import PageIntro from "../components/PageIntro.astro";
import { PRODUCT_LIST } from "../lib/products";

const title = "404 - Page not found · danbarclay.dev";
const description =
  "This page on Dan Barclay's site couldn't be found. Head back to the homepage or browse the about / work / projects sections.";

const links: { label: string; value: string; href: string; accent?: string }[] = [
  { label: "Home", value: "Dan Barclay, engineering leader in London", href: "/" },
  { label: "About", value: "Background, profiles and FAQ", href: "/about" },
  { label: "Work", value: "Four products, all live", href: "/work" },
  ...PRODUCT_LIST.map((p) => ({ label: p.name, value: p.tagline, href: p.href, accent: p.accent })),
  { label: "GitHub", value: "github.com/barclayd", href: "https://github.com/barclayd" },
];
---

<Base title={title} description={description}>
  <PageIntro
    eyebrow="Error · 404"
    title="Page"
    dim="Not found."
    lead="That page on Dan Barclay's site couldn't be found. It may have moved, or it may never have existed. The links below lead somewhere useful."
    tall
  >
    <div class="cta-row" data-stagger="90" data-delay="1000">
      <Cta href="/" data-reveal="up">Back to home</Cta>
    </div>
  </PageIntro>

  <section class="directory" aria-labelledby="directory-title">
    <div class="wrap">
      <h2 id="directory-title" class="eyebrow directory__title" data-reveal="track">Site directory</h2>
      <ul class="links" data-stagger="50">
        {
          links.map((l) => (
            <li data-reveal="up">
              <a
                class="link"
                href={l.href}
                style={l.accent ? `--accent:${l.accent}` : undefined}
                {...(l.href.startsWith("/") ? {} : { target: "_blank", rel: "noopener me" })}
              >
                <span class="link__label">
                  {l.accent && <span class="dot link__dot" aria-hidden="true" />}
                  {l.label}
                </span>
                <span class="link__value">
                  {l.value}
                  <span aria-hidden="true">{l.href.startsWith("/") ? " →" : " ↗"}</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<style>
  .directory {
    padding-bottom: clamp(120px, 18vh, 200px);
  }

  .directory__title {
    display: block;
    margin-bottom: 28px;
  }

  .links {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
    column-gap: 32px;
    border-top: 1px solid var(--color-line-3);
  }

  .link {
    display: flex;
    flex-direction: column;
    gap: 8px;
    height: 100%;
    padding: 24px 20px 24px 0;
    border-bottom: 1px solid var(--color-line-2);
    transition: border-color 0.4s;
  }

  .link:hover {
    border-color: rgba(255, 255, 255, 0.4);
  }

  .link__label {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-label);
  }

  .link__dot {
    width: 6px;
    height: 6px;
  }

  .link__value {
    font-size: 17px;
    color: var(--color-ink);
    transition: color 0.4s;
  }

  .link:hover .link__value {
    color: var(--color-ink-hi);
  }
</style>
