      type="button"
      popovertarget="toc-sheet"
      class="toc-pill fixed whitespace-nowrap bottom-[max(1rem,env(safe-area-inset-bottom))] left-1/2 z-40 flex items-center gap-2 border border-[var(--color-rule-strong)] bg-[var(--color-panel)]/95 px-4 py-2.5 font-mono text-[10px] uppercase tracking-hud text-[var(--color-text)] shadow-lg backdrop-blur lg:hidden"
      aria-label="Chapters"
    >
      <span id="toc-pill-label">Contents</span><span aria-hidden="true" class="text-[var(--color-amber)]">▴</span>
    </button>
    <div
      id="toc-sheet"
      popover
      class="toc-sheet m-0 w-[calc(100vw-2rem)] max-w-sm border border-[var(--color-rule-strong)] bg-[var(--color-panel)] p-2 text-[var(--color-text)]"
    >
      <ol>
        {chapters.map(([id, num, label]) => (
          <li>
            <a href={`#${id}`} data-toc={id} class="toc-link flex gap-3 px-3 py-2.5 font-mono text-[11px] uppercase tracking-hud text-[var(--color-mute)]">
              <span class="w-6 shrink-0">{num}</span><span>{label}</span>
            </a>
          </li>
        ))}
      </ol>
    </div>

    <SubPageFooter />
  </main>

  <script is:inline>
    // Reading rail: highlight the chapter under the reading line; show the mobile pill inside the article.
    (function () {
      const sections = Array.from(document.querySelectorAll(".chapter"));
      const links = Array.from(document.querySelectorAll("[data-toc]"));
      const pill = document.getElementById("toc-pill");
      const label = document.getElementById("toc-pill-label");
      const sheet = document.getElementById("toc-sheet");
      const visible = new Set();
      function render() {
        const active = sections.filter((s) => visible.has(s)).pop();
        const id = active ? active.id : "";
        for (const a of links) {
          if (a.dataset.toc === id) a.setAttribute("aria-current", "true");
          else a.removeAttribute("aria-current");
        }
        pill.dataset.show = active ? "true" : "false";
        // Short label from the contents list, so the pill stays on one line.
        if (active) label.textContent = active.dataset.n + " · " + sheet.querySelector('[data-toc="' + id + '"] span:last-child').textContent;
      }
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) e.isIntersecting ? visible.add(e.target) : visible.delete(e.target);
          render();
        },
        { rootMargin: "-30% 0px -65% 0px" }
      );
      sections.forEach((s) => io.observe(s));
      sheet.addEventListener("click", (e) => {
        if (e.target.closest("a")) sheet.hidePopover();
      });
      render();
    })();
  </script>
</Base>

