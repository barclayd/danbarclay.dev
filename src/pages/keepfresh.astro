---
import Base from "../layouts/Base.astro";
import HudFrame from "../components/HudFrame.astro";
import SubPageHeader from "../components/SubPageHeader.astro";
import SubPageFooter from "../components/SubPageFooter.astro";
import LiveSiteIntercept from "../components/LiveSiteIntercept.astro";

const title =
  "KeepFresh - iOS Grocery Tracker · Built by Dan Barclay";
const description =
  "KeepFresh is an iOS app built by Dan Barclay (engineering leader, London) that helps households end food waste - tracking grocery inventory and surfacing expiry alerts. 77,000+ downloads, hundreds of daily households.";

const PERSON_ID = "https://danbarclay.dev/#person";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "MobileApplication",
    "@id": "https://danbarclay.dev/keepfresh#app",
    name: "KeepFresh",
    url: "https://keepfre.sh",
    applicationCategory: "LifestyleApplication",
    operatingSystem: "iOS",
    description:
      "An iOS app that helps households end food waste by tracking grocery inventory and surfacing expiry alerts. 77,000+ downloads, used daily by hundreds of households. Built in Swift with a Hono.js + Cloudflare Workers backend.",
    creator: { "@id": PERSON_ID },
    author: { "@id": PERSON_ID },
    founder: { "@id": PERSON_ID },
    publisher: { "@id": PERSON_ID },
  },
];

const facts = [
  { k: "PLATFORM", v: "iOS · SWIFT" },
  { k: "FOUNDER", v: "DAN BARCLAY" },
  { k: "BACKEND", v: "HONO.JS · CF WORKERS · D1" },
  { k: "DOWNLOADS", v: "77,000+" },
  { k: "WEB", v: "KEEPFRE.SH" },
];
---

<Base
  title={title}
  description={description}
  pageType="WebPage"
  jsonLd={schema}
  breadcrumbs={[
    { name: "Home", url: "/" },
    { name: "Work", url: "/work" },
    { name: "KeepFresh" },
  ]}
>
  <main
    class="mx-auto flex w-full max-w-[1100px] flex-col gap-12 py-10 sm:gap-16 sm:py-14 lg:gap-20 pl-[max(1rem,env(safe-area-inset-left))] pr-[max(1rem,env(safe-area-inset-right))] sm:pl-[max(2rem,env(safe-area-inset-left))] sm:pr-[max(2rem,env(safe-area-inset-right))] lg:pl-[max(3rem,env(safe-area-inset-left))] lg:pr-[max(3rem,env(safe-area-inset-right))]"
  >
    <SubPageHeader current="keepfresh" />

    <HudFrame
      label="KEEPFRESH"
      index="LIVE"
      className="px-6 py-10 sm:px-10 sm:py-14"
    >
      <div class="mb-4 flex items-center gap-2 font-mono text-[10px] uppercase tracking-hud text-[var(--color-mute)]">
        <span class="h-px w-6 bg-[var(--color-amber)]"></span>
        <span>PROJECT · 02 · BY DAN BARCLAY</span>
      </div>
      <h1
        class="font-display font-semibold uppercase leading-[0.95] tracking-tight text-[var(--color-text-bright)]"
        style="font-size: clamp(2.5rem, 9vw, 5rem);"
      >
        KeepFresh
      </h1>
      <p class="mt-6 max-w-2xl font-display text-base leading-relaxed text-[var(--color-mute)] sm:text-lg">
        <strong class="text-[var(--color-text-bright)]">KeepFresh</strong> is an
        iOS app built and operated by
        <a href="/about" class="text-[var(--color-amber)] hover:text-[var(--color-amber-glow)]">Dan Barclay</a>
        that helps households end food waste. It tracks grocery inventory and
        surfaces expiry alerts before things spoil. 77,000+ downloads, used
        daily by hundreds of households.
      </p>

      <div class="my-10 h-px w-full bg-[var(--color-rule)]"></div>

      {/* Live mirrored feed of keepfre.sh - windscreen-HUD intercept. */}
      <div class="mt-2 mb-4 flex items-center gap-2 font-mono text-[10px] uppercase tracking-hud text-[var(--color-mute)]">
        <span class="h-px w-6 bg-[var(--color-amber)]"></span>
        <span>LIVE · INTERCEPT · PROJECTED FEED</span>
      </div>
      <LiveSiteIntercept
        id="keepfresh"
        src="https://keepfre.sh"
        host="KEEPFRE.SH"
        signal="KEEPFRESH · MIRROR"
        ctaLabel="ENTER LIVE INSTANCE"
      />

      <div class="my-10 h-px w-full bg-[var(--color-rule)]"></div>

      <div class="grid grid-cols-2 gap-px bg-[var(--color-rule)] sm:grid-cols-5">
        {facts.map((f) => (
          <div class="bg-[var(--color-void)] px-3 py-3">
            <div class="font-mono text-[9px] uppercase tracking-hud text-[var(--color-mute)]">{f.k}</div>
            <div class="mt-1 font-mono text-[11px] uppercase text-[var(--color-text)]">{f.v}</div>
          </div>
        ))}
      </div>

      <div class="mt-12 grid gap-10 md:grid-cols-2">
        <div>
          <h2 class="font-display text-xl font-semibold uppercase tracking-tight text-[var(--color-text-bright)] sm:text-2xl">
            Problem
          </h2>
          <p class="mt-4 font-display text-base leading-relaxed text-[var(--color-mute)]">
            A third of food bought for households is thrown away. Most of it
            because someone forgot what was in the fridge, or how long it had
            been there. Existing trackers are tedious to maintain - you don't
            stay with them.
          </p>
        </div>
        <div>
          <h2 class="font-display text-xl font-semibold uppercase tracking-tight text-[var(--color-text-bright)] sm:text-2xl">
            Solution
          </h2>
          <p class="mt-4 font-display text-base leading-relaxed text-[var(--color-mute)]">
            A native iOS app designed around the fewest possible taps to add a
            grocery item, with smart expiry inference and push notifications
            that fire just before things go off. Built in Swift, hardened by
            actual use.
          </p>
        </div>
      </div>

      <div class="mt-12 grid gap-10 md:grid-cols-2">
        <div>
          <h2 class="font-display text-xl font-semibold uppercase tracking-tight text-[var(--color-text-bright)] sm:text-2xl">
            Stack
          </h2>
          <ul class="mt-4 space-y-2 font-display text-base leading-relaxed text-[var(--color-mute)]">
            <li>· iOS app · Swift · SwiftUI</li>
            <li>· Backend · Hono.js on Cloudflare Workers</li>
            <li>· Storage · Cloudflare D1</li>
            <li>· Scheduled runners for expiry alerts</li>
          </ul>
        </div>
        <div>
          <h2 class="font-display text-xl font-semibold uppercase tracking-tight text-[var(--color-text-bright)] sm:text-2xl">
            Author
          </h2>
          <p class="mt-4 font-display text-base leading-relaxed text-[var(--color-mute)]">
            <a href="/about" class="text-[var(--color-text-bright)] hover:text-[var(--color-amber-glow)]">Dan Barclay</a>
            is an engineering leader based in London. KeepFresh - an iOS app
            working to end food waste for good - is one of two products he
            is focused on building. The other is
            <a href="/promptly" class="text-[var(--color-text-bright)] hover:text-[var(--color-amber-glow)]">Promptly</a>,
            the CMS powering the next wave of AI development.
          </p>
        </div>
      </div>

      <div class="mt-12 flex flex-wrap gap-3">
        <a
          href="https://keepfre.sh"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 border border-[var(--color-amber-dim)] bg-[rgba(232,154,60,0.06)] px-5 py-3 font-mono text-xs uppercase tracking-hud text-[var(--color-amber)] hover:bg-[rgba(232,154,60,0.12)] hover:text-[var(--color-amber-glow)]"
        >
          <span>VISIT KEEPFRE.SH</span><span aria-hidden="true">↗</span>
        </a>
        <a
          href="https://github.com/barclayd/keepfresh-ios"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 border border-[var(--color-rule-strong)] px-5 py-3 font-mono text-xs uppercase tracking-hud text-[var(--color-mute)] hover:text-[var(--color-amber-glow)]"
        >
          <span>GITHUB · IOS</span><span aria-hidden="true">↗</span>
        </a>
        <a
          href="https://github.com/barclayd/keepfresh-api"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 border border-[var(--color-rule-strong)] px-5 py-3 font-mono text-xs uppercase tracking-hud text-[var(--color-mute)] hover:text-[var(--color-amber-glow)]"
        >
          <span>GITHUB · API</span><span aria-hidden="true">↗</span>
        </a>
      </div>
    </HudFrame>

    <SubPageFooter />
  </main>
</Base>
