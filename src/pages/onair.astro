---
import Base from "../layouts/Base.astro";
import HudFrame from "../components/HudFrame.astro";
import SubPageHeader from "../components/SubPageHeader.astro";
import SubPageFooter from "../components/SubPageFooter.astro";
import LiveSiteIntercept from "../components/LiveSiteIntercept.astro";

const title =
  "On Air - Push-to-Talk Dictation for Mac · Built by Dan Barclay";
const description =
  "On Air is a free macOS app built by Dan Barclay (engineering leader, London) for push-to-talk dictation. Hold fn, speak, let go - the transcript is pasted into the text field you were typing in. A soft red glow is the only interface.";

const PERSON_ID = "https://danbarclay.dev/#person";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "@id": "https://danbarclay.dev/onair#app",
    name: "On Air",
    alternateName: "OnAir",
    url: "https://useonair.app",
    downloadUrl: "https://github.com/barclayd/on-air/releases/latest/download/On-Air.dmg",
    applicationCategory: "UtilitiesApplication",
    operatingSystem: "macOS",
    description:
      "A free native macOS app for push-to-talk dictation. Hold fn, speak and let go: audio streams to OpenAI live transcription while a red glow responds to your voice, then the finished transcript is pasted into the original text field. Audio is held only in memory, never written to disk. Built in Swift 6 and SwiftUI.",
    offers: { "@type": "Offer", price: "0", priceCurrency: "GBP" },
    creator: { "@id": PERSON_ID },
    author: { "@id": PERSON_ID },
    founder: { "@id": PERSON_ID },
    publisher: { "@id": PERSON_ID },
  },
];

const facts = [
  { k: "TYPE", v: "FREE MAC APP · DICTATION" },
  { k: "FOUNDER", v: "DAN BARCLAY" },
  { k: "STACK", v: "SWIFT 6 · SWIFTUI · OPENAI" },
  { k: "STATUS", v: "LAUNCHED OCT 2026" },
  { k: "WEB", v: "USEONAIR.APP" },
];
---

<Base
  title={title}
  description={description}
  pageType="WebPage"
  jsonLd={schema}
  breadcrumbs={[
    { name: "Home", url: "/" },
    { name: "Work", url: "/work" },
    { name: "On Air" },
  ]}
>
  <main
    class="mx-auto flex w-full max-w-[1100px] flex-col gap-12 py-10 sm:gap-16 sm:py-14 lg:gap-20 pl-[max(1rem,env(safe-area-inset-left))] pr-[max(1rem,env(safe-area-inset-right))] sm:pl-[max(2rem,env(safe-area-inset-left))] sm:pr-[max(2rem,env(safe-area-inset-right))] lg:pl-[max(3rem,env(safe-area-inset-left))] lg:pr-[max(3rem,env(safe-area-inset-right))]"
  >
    <SubPageHeader current="onair" />

    <HudFrame
      label="ON AIR"
      index="LIVE"
      className="px-6 py-10 sm:px-10 sm:py-14"
    >
      <div class="mb-4 flex items-center gap-2 font-mono text-[10px] uppercase tracking-hud text-[var(--color-mute)]">
        <span class="h-px w-6 bg-[var(--color-amber)]"></span>
        <span>PROJECT · 04 · BY DAN BARCLAY</span>
      </div>
      <h1
        class="font-display font-semibold uppercase leading-[0.95] tracking-tight text-[var(--color-text-bright)]"
        style="font-size: clamp(2.5rem, 9vw, 5rem);"
      >
        On Air
      </h1>
      <p class="mt-6 max-w-2xl font-display text-base leading-relaxed text-[var(--color-mute)] sm:text-lg">
        <strong class="text-[var(--color-text-bright)]">On Air</strong> is a
        free Mac app built and operated by{" "}
        <a href="/about" class="text-[var(--color-amber)] hover:text-[var(--color-amber-glow)]">Dan Barclay</a>{" "}
        for push-to-talk dictation. Hold fn, speak, and let go - the
        transcript lands in whatever text field you were typing in. No
        windows, menus or timers: a soft red glow tells you it's listening.
      </p>

      <div class="my-10 h-px w-full bg-[var(--color-rule)]"></div>

      {/* Live mirrored feed of useonair.app - windscreen-HUD intercept. */}
      <div class="mt-2 mb-4 flex items-center gap-2 font-mono text-[10px] uppercase tracking-hud text-[var(--color-mute)]">
        <span class="h-px w-6 bg-[var(--color-amber)]"></span>
        <span>LIVE PREVIEW</span>
      </div>
      <LiveSiteIntercept
        id="onair"
        src="https://useonair.app"
        host="USEONAIR.APP"
        signal="ON AIR · LIVE SITE"
        ctaLabel="ENTER LIVE INSTANCE"
      />

      <div class="my-10 h-px w-full bg-[var(--color-rule)]"></div>

      <div class="grid grid-cols-2 gap-px bg-[var(--color-rule)] sm:grid-cols-5">
        {facts.map((f) => (
          <div class="bg-[var(--color-void)] px-3 py-3">
            <div class="font-mono text-[9px] uppercase tracking-hud text-[var(--color-mute)]">{f.k}</div>
            <div class="mt-1 font-mono text-[11px] uppercase text-[var(--color-text)]">{f.v}</div>
          </div>
        ))}
      </div>

      <div class="mt-12 grid gap-10 md:grid-cols-2">
        <div>
          <h2 class="font-display text-xl font-semibold uppercase tracking-tight text-[var(--color-text-bright)] sm:text-2xl">
            Problem
          </h2>
          <p class="mt-4 font-display text-base leading-relaxed text-[var(--color-mute)]">
            Speaking is faster than typing, but most dictation tools put
            something between you and your words - a floating window, a
            menu, a timer, a monthly subscription. Then they paste into the
            wrong place, or quietly overwrite whatever was on your clipboard.
          </p>
        </div>
        <div>
          <h2 class="font-display text-xl font-semibold uppercase tracking-tight text-[var(--color-text-bright)] sm:text-2xl">
            Solution
          </h2>
          <p class="mt-4 font-display text-base leading-relaxed text-[var(--color-mute)]">
            Hold fn and speak. Audio streams to OpenAI's live transcription
            while a red glow rises with your voice. Let go, a blue line shows
            it finishing, and the text is pasted into the field you started
            in. If focus has moved, it waits in the menu bar to copy instead.
            Your clipboard is restored, and audio never touches the disk.
          </p>
        </div>
      </div>

      <div class="mt-12 grid gap-10 md:grid-cols-2">
        <div>
          <h2 class="font-display text-xl font-semibold uppercase tracking-tight text-[var(--color-text-bright)] sm:text-2xl">
            Stack
          </h2>
          <ul class="mt-4 space-y-2 font-display text-base leading-relaxed text-[var(--color-mute)]">
            <li>· Swift 6 · SwiftUI · native menu-bar app</li>
            <li>· OpenAI live transcription, your own key in Keychain</li>
            <li>· Developer ID signed and notarized</li>
            <li>· Site on Remix 3 · Cloudflare Workers</li>
          </ul>
        </div>
        <div>
          <h2 class="font-display text-xl font-semibold uppercase tracking-tight text-[var(--color-text-bright)] sm:text-2xl">
            Author
          </h2>
          <p class="mt-4 font-display text-base leading-relaxed text-[var(--color-mute)]">
            <a href="/about" class="text-[var(--color-text-bright)] hover:text-[var(--color-amber-glow)]">Dan Barclay</a>{" "}
            is an engineering leader based in London. On Air - push-to-talk
            dictation for Mac - is one of four products he is focused on
            building. The others are{" "}
            <a href="/promptly" class="text-[var(--color-text-bright)] hover:text-[var(--color-amber-glow)]">Promptly</a>,
            the CMS powering the next wave of AI development,{" "}
            <a href="/keepfresh" class="text-[var(--color-text-bright)] hover:text-[var(--color-amber-glow)]">KeepFresh</a>,
            an iOS app working to end food waste for good, and{" "}
            <a href="/stitch" class="text-[var(--color-text-bright)] hover:text-[var(--color-amber-glow)]">Stitch</a>,
            a free web app that combines split Strava rides into one activity.
          </p>
        </div>
      </div>

      <div class="mt-12 flex flex-wrap gap-3">
        <a
          href="https://useonair.app"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 border border-[var(--color-amber-dim)] bg-[rgba(232,154,60,0.06)] px-5 py-3 font-mono text-xs uppercase tracking-hud text-[var(--color-amber)] hover:bg-[rgba(232,154,60,0.12)] hover:text-[var(--color-amber-glow)]"
        >
          <span>VISIT USEONAIR.APP</span><span aria-hidden="true">↗</span>
        </a>
        <a
          href="https://github.com/barclayd/on-air"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 border border-[var(--color-rule-strong)] px-5 py-3 font-mono text-xs uppercase tracking-hud text-[var(--color-mute)] hover:text-[var(--color-amber-glow)]"
        >
          <span>GITHUB</span><span aria-hidden="true">↗</span>
        </a>
      </div>
    </HudFrame>

    <SubPageFooter />
  </main>
</Base>
