---
import Product from "../layouts/Product.astro";

const title =
  "On Air - Free Wispr Flow Alternative for Mac · Built by Dan Barclay";
const description =
  "On Air is a tasteful, free-forever alternative to Wispr Flow, built by Dan Barclay (engineering leader, London) for developers who want to ramp up their AI-driven coding throughput with voice transcription. Hold fn, speak, let go - the transcript is pasted into the text field you were typing in.";

const PERSON_ID = "https://danbarclay.dev/#person";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "@id": "https://danbarclay.dev/onair#app",
    name: "On Air",
    alternateName: "OnAir",
    url: "https://useonair.app",
    downloadUrl: "https://github.com/barclayd/on-air/releases/latest/download/On-Air.dmg",
    applicationCategory: "UtilitiesApplication",
    operatingSystem: "macOS",
    description:
      "A tasteful, free-forever alternative to Wispr Flow: a native macOS app for push-to-talk dictation, built for developers who want to ramp up their AI-driven coding throughput with voice transcription. Hold fn, speak and let go: audio streams to OpenAI live transcription while a red glow responds to your voice, then the finished transcript is pasted into the original text field. Audio is held only in memory, never written to disk. Built in Swift 6 and SwiftUI.",
    offers: { "@type": "Offer", price: "0", priceCurrency: "GBP" },
    creator: { "@id": PERSON_ID },
    author: { "@id": PERSON_ID },
    founder: { "@id": PERSON_ID },
    publisher: { "@id": PERSON_ID },
  },
];
---

<Product product="onair" title={title} description={description} schema={schema} />
