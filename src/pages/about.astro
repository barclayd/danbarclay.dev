---
import Base from "../layouts/Base.astro";
import Cta from "../components/Cta.astro";
import podcastsRaw from "../data/podcasts.json";
import soRaw from "../data/stackoverflow.json";
import { PRODUCT_LIST } from "../lib/products";
import type { Podcast, StackOverflowData } from "../lib/types";

const podcasts = (podcastsRaw as Podcast[]).slice().sort((a, b) => {
  if (a.featured !== b.featured) return a.featured ? -1 : 1;
  return new Date(b.publishedAt).getTime() - new Date(a.publishedAt).getTime();
});
const featuredPodcast = podcasts[0];

const title =
  "About Dan Barclay - Engineering Leader, Founder of Promptly, KeepFresh, Stitch & On Air, London";
const description =
  "Dan Barclay is an engineering leader, full-stack product engineer and founder based in London. 10+ years building product and AI experiences for millions of users. Founder of Promptly (LLM prompt CMS), KeepFresh (iOS app, 77K+ downloads), Stitch (free Strava ride-combining web app) and On Air (free-forever Wispr Flow alternative for Mac).";

const faqs = [
  {
    q: "Who is Dan Barclay?",
    a: "Dan Barclay is an engineering leader and founder based in London, UK. He is a full-stack product engineer with 10+ years of experience building and scaling software to millions of users. He is the founder of Promptly, a B2B SaaS CMS for LLM prompts used by 100+ companies, KeepFresh, an iOS app with 77,000+ downloads that helps households track grocery inventory and reduce food waste, Stitch, a free web app that combines split Strava rides into one activity, and On Air, a free-forever Wispr Flow alternative for Mac.",
  },
  {
    q: "Where is Dan Barclay based?",
    a: "Dan Barclay is based in London, United Kingdom.",
  },
  {
    q: "What does Dan Barclay work on?",
    a: "Dan Barclay is focused on building four products: Promptly (promptlycms.com), the CMS powering the next wave of AI development - used in production by 100+ companies to author, version and ship LLM prompts without a code deploy - KeepFresh (keepfre.sh), an iOS app working to end food waste for good, with 77,000+ downloads - Stitch (stravastitch.com), a free web app that combines split Strava rides into one activity - and On Air (useonair.app), a free-forever Wispr Flow alternative for Mac, built for developers who code with AI by voice. His technical work spans TypeScript, React, Node, Python, Rust, Swift, and AI tooling including LLMs and the Model Context Protocol.",
  },
  {
    q: "Is Dan Barclay active on Stack Overflow?",
    a: "Yes. Dan Barclay has contributed on Stack Overflow since 2018 at stackoverflow.com/users/9961739/dan-barclay. His highest-scoring answers are in TypeScript, JavaScript and React, including a widely referenced answer on the \"'React' refers to a UMD global, but the current file is a module\" TypeScript error. His Stack Overflow tag scores are a community-voted record of his specialities.",
  },
  {
    q: "Is Dan Barclay the same person as the BMO Capital Markets executive?",
    a: "No. This Dan Barclay is a software engineer and founder based in London, UK. He is unrelated to Dan Barclay, the retired CEO of BMO Capital Markets in Toronto, Canada. They share a name and nothing else.",
  },
  {
    q: "How can I contact Dan Barclay?",
    a: "Email barclaysd@me.com, or reach out via GitHub (@barclayd), X (@danielbarclay), or LinkedIn (/in/barclayd). I typically reply within 24 hours.",
  },
  {
    q: "What is Promptly?",
    a: "Promptly is a B2B SaaS CMS founded by Dan Barclay that lets non-engineers - product managers, domain experts, marketers - author, version and ship the LLM prompts that power production AI features, without going through a code deploy. It is used in production by 100+ companies. Learn more at promptlycms.com.",
  },
  {
    q: "What is KeepFresh?",
    a: "KeepFresh is an iOS app built by Dan Barclay that helps households end food waste by tracking grocery inventory and surfacing expiry alerts. It has 77,000+ downloads and is used daily by hundreds of households. The backend runs on Hono.js on Cloudflare Workers with D1 storage. Learn more at keepfre.sh.",
  },
  {
    q: "What is Stitch?",
    a: "Stitch is a free web app built by Dan Barclay that combines two or more split Strava rides into a single activity. Athletes preview the route and gaps, download a merged GPX and backups, then explicitly confirm the upload to Strava. It never deletes activities. Built in TypeScript with Remix 3 on Cloudflare Workers and Durable Objects. Learn more at stravastitch.com.",
  },
  {
    q: "What is On Air?",
    a: "On Air is a tasteful, free-forever alternative to Wispr Flow, built by Dan Barclay for developers who want to ramp up their AI-driven coding throughput with voice transcription. Hold the fn key, speak, and let go: a red glow responds to your voice while audio streams to OpenAI live transcription, then the finished transcript is pasted into the text field you were typing in. Audio is held only in memory, never written to disk. Built in Swift 6 and SwiftUI. Learn more at useonair.app.",
  },
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "@id": "https://danbarclay.dev/about#faq",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
  about: { "@id": "https://danbarclay.dev/#person" },
};

const fmt = (n: number) => n.toLocaleString("en-GB");
const pad = (n: number) => String(n).padStart(2, "0");

const facts = [
  { value: "London", label: "Based" },
  { value: "Eng lead", label: "Role" },
  { value: "10+ yrs", count: 10, suffix: "+ yrs", label: "Experience" },
  { value: "Product + AI", label: "Focus" },
];

const stack = ["TypeScript", "React", "Node", "Python", "Rust", "Swift", "LLMs", "MCP"];

// Stack Overflow: bars are scaled to the top tag; the top three read brightest.
const so = soRaw as StackOverflowData;
const totalScore = so.tags.reduce((n, t) => n + t.score, 0);
const maxScore = Math.max(...so.tags.map((t) => t.score));
const tagBars = so.tags.map((t, i) => ({
  ...t,
  width: `${((t.score / maxScore) * 100).toFixed(1)}%`,
  dim: i >= 3,
}));

const episode = featuredPodcast;
const episodeMeta = [
  episode.show,
  episode.role,
  new Date(episode.publishedAt).toLocaleDateString("en-GB", { month: "short", year: "numeric", timeZone: "UTC" }),
  `${Math.round(episode.durationSeconds / 60)} min`,
].join(" · ");

const profiles: { label: string; value: string; href: string; accent?: string }[] = [
  { label: "GitHub", value: "github.com/barclayd", href: "https://github.com/barclayd" },
  { label: "X", value: "x.com/danielbarclay", href: "https://x.com/danielbarclay" },
  { label: "LinkedIn", value: "linkedin.com/in/barclayd", href: "https://www.linkedin.com/in/barclayd/" },
  { label: "Stack Overflow", value: "users/9961739", href: so.url },
  { label: "Tweets archive", value: "danbarclay.dev/tweets", href: "/tweets" },
  { label: "Email", value: "barclaysd@me.com", href: "mailto:barclaysd@me.com" },
  ...PRODUCT_LIST.map((p) => ({ label: p.name, value: p.siteLabel, href: p.site, accent: p.accent })),
];
const isExternal = (href: string) => href.startsWith("http");
---

<Base
  title={title}
  description={description}
  pageType="AboutPage"
  jsonLd={faqJsonLd}
  active="about"
  breadcrumbs={[
    { name: "Home", url: "/" },
    { name: "About" },
  ]}
>
  <!-- ====== Intro ====== -->
  <section class="intro" aria-labelledby="about-title">
    <div class="intro__glow" aria-hidden="true">
      <div class="glow" style="--glow-color:rgba(242,242,239,0.08)" data-loop="breathe"></div>
    </div>

    <div class="wrap intro__inner">
      <div class="intro__row">
        <div class="intro__text">
          <span class="eyebrow intro__eyebrow" data-reveal="track" data-delay="600">About</span>
          <h1 id="about-title" class="intro__title">
            <span class="line-mask"><span data-reveal="rise" data-delay="420">Dan</span></span>{" "}
            <span class="line-mask"><span data-reveal="rise" data-delay="540">Barclay</span></span>
          </h1>
          <p class="intro__lead" data-reveal="up" data-delay="900">
            Engineering leader, full-stack product engineer and founder, based in London. I've spent ten years
            building and scaling software for millions of people across consumer marketplaces, B2B SaaS, mobile apps
            and AI tooling.
          </p>
          <p class="body intro__body" data-reveal="up" data-delay="1000">
            I do my best work on hard problems, where technical vision and product judgement have to line up with
            business outcomes to ship something mission-critical.
          </p>
          <!-- Disambiguation for crawlers and LLMs; mirrors the FAQ answer below. -->
          <aside class="sr-only-seo">
            Note - disambiguation: This Dan Barclay is a London-based software engineer and founder. He is unrelated to
            Dan Barclay, the retired CEO of BMO Capital Markets in Toronto, Canada. They share a name and nothing else.
          </aside>
        </div>

        <div class="intro__portrait" data-reveal="wipe" data-delay="500" data-dur="1800">
          <div class="intro__parallax" data-parallax="0.06">
            <img
              src="/dan-barclay.webp"
              alt="Dan Barclay - engineering leader and founder, London"
              width="512"
              height="512"
              fetchpriority="high"
              decoding="async"
            />
          </div>
        </div>
      </div>

      <div class="facts">
        <div class="facts__rule" data-reveal="line" aria-hidden="true"></div>
        <dl class="facts__grid" data-stagger="100">
          {
            facts.map((f) => (
              <div class="facts__item" data-reveal="up">
                <dt class="stat-label">{f.label}</dt>
                {f.count !== undefined ? (
                  <dd class="facts__value" data-count={f.count} data-suffix={f.suffix}>{f.value}</dd>
                ) : (
                  <dd class="facts__value">{f.value}</dd>
                )}
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  <!-- ====== Now building ====== -->
  <section class="section" aria-labelledby="building-title">
    <div class="wrap">
      <div class="section-head">
        <div class="section-head__title">
          <span class="eyebrow" data-reveal="track">Now building</span>
          <h2 id="building-title" class="h2" data-reveal="up">Four products</h2>
        </div>
        <p class="section-head__copy" data-reveal="up" data-delay="120">
          Each one designed, built and operated end to end.
        </p>
      </div>

      <ul class="builds">
        {
          PRODUCT_LIST.map((p) => (
            <li>
              <a class="build" href={p.href} style={`--accent:${p.accent}`} data-reveal="up">
                <div class="build__main">
                  <span class="build__idx" aria-hidden="true">{p.n}</span>
                  <div class="build__text">
                    <span class="build__name">
                      <span class="dot build__dot" aria-hidden="true" />
                      {p.name}
                    </span>
                    <span class="build__desc">{p.row.desc}</span>
                  </div>
                </div>
                <div class="build__side">
                  <div class="build__metric">
                    <span class="num build__num">{p.row.metric}</span>
                    <span class="stat-label">{p.row.label}</span>
                  </div>
                  <span class="build__arrow" aria-hidden="true">→</span>
                </div>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ====== Stack ====== -->
  <section class="section" aria-labelledby="stack-title">
    <div class="wrap stack">
      <div class="section-head__title">
        <span class="eyebrow" data-reveal="track">Stack</span>
        <h2 id="stack-title" class="h2" data-reveal="up">Tools of choice</h2>
      </div>
      <ul class="stack__list" data-stagger="70">
        {
          stack.map((word, i) => (
            <>
              {i > 0 && (
                <li class="stack__sep" aria-hidden="true" data-reveal="fade">
                  /
                </li>
              )}
              <li data-reveal="up">{word}</li>
            </>
          ))
        }
      </ul>
      <p class="body stack__copy" data-reveal="up">
        Alongside the languages, a deep working focus on large language models, the Model Context Protocol and the
        engineering practices needed to ship AI features safely into production.
      </p>
    </div>
  </section>

  <!-- ====== Stack Overflow ====== -->
  <section class="section" aria-labelledby="so-title">
    <div class="wrap">
      <div class="section-head">
        <div class="section-head__title">
          <span class="eyebrow" data-reveal="track">Stack Overflow · Since {so.memberSince}</span>
          <h2 id="so-title" class="h2" data-reveal="up">Specialities, scored</h2>
        </div>
        <p class="section-head__copy" data-reveal="up" data-delay="120">
          Answers on TypeScript, JavaScript and React that other engineers have voted into the site's reference
          material.
        </p>
      </div>

      <div class="so">
        <div class="so__left">
          <div class="so__rep" data-reveal="up">
            <span class="num so__rep-num" data-count={so.reputation}>{fmt(so.reputation)}</span>
            <span class="stat-label">Reputation</span>
          </div>
          <dl class="so__facts" data-stagger="90">
            <div data-reveal="up">
              <dt class="stat-label">Answers</dt>
              <dd class="num so__fact">{so.answers}</dd>
            </div>
            <div data-reveal="up">
              <dt class="stat-label">Gold · Silver · Bronze</dt>
              <dd class="num so__fact">{`${so.badges.gold} · ${so.badges.silver} · ${so.badges.bronze}`}</dd>
            </div>
          </dl>
        </div>

        <div class="so__right">
          <div class="so__bars-head stat-label">
            <span>Share of answer score</span>
            <span>{fmt(totalScore)} total</span>
          </div>
          <ul class="so__bars" data-stagger="90">
            {
              tagBars.map((t) => (
                <li class="so__bar">
                  <div class="so__bar-row">
                    <span>{t.tag}</span>
                    <span class="so__bar-meta">
                      {`${fmt(t.score)} · ${t.answers} ${t.answers === 1 ? "answer" : "answers"}`}
                    </span>
                  </div>
                  <div class="so__track" aria-hidden="true">
                    <div class:list={["so__fill", t.dim && "is-dim"]} style={`width:${t.width}`} data-reveal="line" />
                  </div>
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <a class="so__top" href={so.topAnswer.url} target="_blank" rel="noopener" data-reveal="up">
        <div class="so__top-main">
          <span class="num so__top-score">+{so.topAnswer.score}</span>
          <div class="so__top-text">
            <span class="stat-label">Highest-scoring answer</span>
            <span class="so__top-title">{so.topAnswer.title}</span>
            <span class="so__top-meta">Answered {so.topAnswer.year} · {so.topAnswer.tags.join(" · ")}</span>
          </div>
        </div>
        <span class="so__top-cta">Read the answer ↗</span>
      </a>
      <a class="text-link so__profile" href={so.url} target="_blank" rel="noopener me" data-reveal="up">
        Full profile ↗
      </a>
    </div>
  </section>

  <!-- ====== Podcasts ====== -->
  {
    episode && (
      <section class="section" aria-labelledby="pod-title">
        <div class="wrap">
          <div class="section-head">
            <div class="section-head__title">
              <span class="eyebrow" data-reveal="track">Podcasts</span>
              <h2 id="pod-title" class="h2" data-reveal="up">On the mic</h2>
            </div>
          </div>

          <div class="pod">
            <div class="pod__art" data-reveal="wipe">
              <img
                src={episode.artworkUrl}
                alt={`${episode.show} artwork`}
                width="640"
                height="640"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="pod__text">
              <span class="stat-label pod__meta" data-reveal="up">{episodeMeta}</span>
              <h3 class="pod__title" data-reveal="up">{episode.title}</h3>
              <p class="body pod__copy" data-reveal="up">{episode.description}</p>
              <div class="cta-row pod__ctas" data-stagger="90">
                <Cta href={episode.spotifyUrl} external data-reveal="up">
                  Listen on Spotify
                </Cta>
                {episode.showUrl && (
                  <Cta href={episode.showUrl} external variant="secondary" data-reveal="up">
                    The show ↗
                  </Cta>
                )}
              </div>
              <a class="text-link pod__all" href="/podcasts" data-reveal="up">
                All episodes →
              </a>
            </div>
          </div>
        </div>
      </section>
    )
  }

  <!-- ====== Profiles ====== -->
  <section class="section" aria-labelledby="profiles-title">
    <div class="wrap">
      <div class="section-head">
        <div class="section-head__title">
          <span class="eyebrow" data-reveal="track">Profiles</span>
          <h2 id="profiles-title" class="h2" data-reveal="up">Find me</h2>
        </div>
        <p class="section-head__copy" data-reveal="up" data-delay="120">
          Every profile below belongs to the same Dan Barclay, engineering leader in London.
        </p>
      </div>

      <ul class="profiles" data-stagger="50">
        {
          profiles.map((pr) => (
            <li data-reveal="up">
              <a
                class="profile"
                href={pr.href}
                style={pr.accent ? `--accent:${pr.accent}` : undefined}
                {...(isExternal(pr.href) ? { target: "_blank", rel: pr.accent ? "noopener" : "noopener me" } : {})}
              >
                <span class="profile__label">
                  {pr.accent && <span class="dot profile__dot" aria-hidden="true" />}
                  {pr.label}
                </span>
                <span class="profile__value">
                  {pr.value}
                  <span aria-hidden="true">{pr.href.startsWith("/") ? " →" : " ↗"}</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ====== FAQ ======
       Native exclusive accordion: <details name> keeps one item open without JS. -->
  <section class="section faq" id="faq" aria-labelledby="faq-title">
    <div class="wrap faq__inner">
      <div class="faq__head section-head__title">
        <span class="eyebrow" data-reveal="track">FAQ</span>
        <h2 id="faq-title" class="h2" data-reveal="up">Questions</h2>
      </div>
      <div class="faq__list" data-reveal="up" data-delay="120">
        {
          faqs.map((f, i) => (
            <details class="faq__item" name="faq" open={i === 0}>
              <summary class="faq__q">
                <span class="faq__q-text">
                  <span class="faq__idx" aria-hidden="true">{pad(i + 1)}</span>
                  <span>{f.q}</span>
                </span>
                <span class="faq__plus" aria-hidden="true">+</span>
              </summary>
              <div class="faq__a">
                <p>{f.a}</p>
                {f.q.startsWith("How can I contact") && (
                  <Cta enquire size="sm">
                    Work with me
                  </Cta>
                )}
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---- Intro ---- */
  .intro {
    position: relative;
    padding-top: calc(64px + 12vh);
    /* Clip the glow sideways only. A vertical clip hides the facts' 56px reveal
       offset at the bottom edge, so the observer never sees them arrive. */
    overflow-x: clip;
  }

  .intro__glow {
    position: absolute;
    right: -20vw;
    top: -10vw;
    width: 70vw;
    height: 70vw;
    pointer-events: none;
  }

  .intro__glow > .glow {
    inset: 0;
  }

  .intro__inner {
    position: relative;
  }

  .intro__row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 56px clamp(40px, 6vw, 120px);
  }

  .intro__text {
    flex: 1 1 560px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 28px;
  }

  .intro__eyebrow {
    letter-spacing: 0.28em;
    color: var(--color-muted);
  }

  .intro__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(44px, 7.4vw, 140px);
    line-height: 0.98;
    letter-spacing: 0.01em;
    text-transform: uppercase;
  }

  .intro__lead {
    max-width: 620px;
    font-size: clamp(18px, 1.5vw, 22px);
    font-weight: 350;
    line-height: 1.55;
    color: var(--color-ink-2);
    text-wrap: pretty;
  }

  .intro__body {
    max-width: 620px;
    line-height: 1.65;
    text-wrap: pretty;
  }

  .intro__portrait {
    position: relative;
    flex: 0 1 420px;
    min-width: 260px;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 2px;
    background: #121418;
  }

  .intro__parallax {
    position: absolute;
    inset: -6% 0;
  }

  .intro__parallax img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 30%;
    filter: grayscale(1) contrast(1.1) brightness(0.85);
  }

  .facts {
    max-width: 1440px;
    margin-top: clamp(56px, 9vh, 96px);
  }

  .facts__rule {
    height: 1px;
    background: rgba(255, 255, 255, 0.18);
    transform-origin: 0 50%;
  }

  .facts__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 180px), 1fr));
    gap: 28px 32px;
    padding-top: 28px;
  }

  .facts__item {
    display: flex;
    flex-direction: column-reverse;
    gap: 12px;
  }

  .facts__item .stat-label {
    font-size: 12px;
  }

  .facts__value {
    font-stretch: 118%;
    font-weight: 220;
    font-size: clamp(26px, 2.6vw, 40px);
    line-height: 1.05;
    font-variant-numeric: tabular-nums;
    color: var(--color-ink);
  }

  /* ---- Now building ---- */
  .builds {
    border-top: 1px solid var(--color-line-3);
  }

  .build {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px 48px;
    padding: 34px 4px;
    border-bottom: 1px solid var(--color-line-2);
    transition: background-color 0.5s var(--ease-out-expo);
  }

  .build:hover {
    background: rgba(255, 255, 255, 0.03);
  }

  .build__main {
    flex: 1 1 440px;
    min-width: 0;
    display: flex;
    align-items: baseline;
    gap: 24px;
  }

  .build__idx {
    flex: none;
    font-size: 12px;
    letter-spacing: 0.1em;
    color: var(--color-label);
    font-variant-numeric: tabular-nums;
  }

  .build__text {
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-width: 0;
  }

  .build__name {
    display: flex;
    align-items: center;
    gap: 14px;
    font-family: var(--font-display);
    font-size: clamp(20px, 2.2vw, 30px);
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--color-ink-hi);
  }

  .build__dot {
    width: 8px;
    height: 8px;
    box-shadow: 0 0 16px var(--accent);
  }

  .build__desc {
    max-width: 620px;
    font-size: 16px;
    line-height: 1.6;
    color: var(--color-muted);
    text-wrap: pretty;
  }

  .build__side {
    display: flex;
    align-items: center;
    gap: 40px;
  }

