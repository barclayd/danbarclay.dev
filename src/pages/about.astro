---
import Base from "../layouts/Base.astro";
import HudFrame from "../components/HudFrame.astro";
import DuotoneAvatar from "../components/DuotoneAvatar.astro";
import SubPageHeader from "../components/SubPageHeader.astro";
import SubPageFooter from "../components/SubPageFooter.astro";
import podcastsRaw from "../data/podcasts.json";
import type { Podcast } from "../lib/types";

const podcasts = (podcastsRaw as Podcast[]).slice().sort((a, b) => {
  if (a.featured !== b.featured) return a.featured ? -1 : 1;
  return new Date(b.publishedAt).getTime() - new Date(a.publishedAt).getTime();
});
const featuredPodcast = podcasts[0];
const podcastCount = podcasts.length;

const title =
  "About Dan Barclay - Engineering Leader, Founder of Promptly & KeepFresh, London";
const description =
  "Dan Barclay is an engineering leader, full-stack product engineer and founder based in London. 10+ years building product and AI experiences for millions of users. Founder of Promptly (LLM prompt CMS) and KeepFresh (iOS app, 77K+ downloads).";

const faqs = [
  {
    q: "Who is Dan Barclay?",
    a: "Dan Barclay is an engineering leader and founder based in London, UK. He is a full-stack product engineer with 10+ years of experience building and scaling software to millions of users. He is the founder of Promptly, a B2B SaaS CMS for LLM prompts used by 100+ companies, and KeepFresh, an iOS app with 77,000+ downloads that helps households track grocery inventory and reduce food waste.",
  },
  {
    q: "Where is Dan Barclay based?",
    a: "Dan Barclay is based in London, United Kingdom.",
  },
  {
    q: "What does Dan Barclay work on?",
    a: "Dan Barclay is focused on building two products: Promptly (promptlycms.com), the CMS powering the next wave of AI development - used in production by 100+ companies to author, version and ship LLM prompts without a code deploy - and KeepFresh (keepfre.sh), an iOS app working to end food waste for good, with 77,000+ downloads. His technical work spans TypeScript, React, Node, Python, Rust, Swift, and AI tooling including LLMs and the Model Context Protocol.",
  },
  {
    q: "Is Dan Barclay the same person as the BMO Capital Markets executive?",
    a: "No. This Dan Barclay is a software engineer and founder based in London, UK. He is unrelated to Dan Barclay, the retired CEO of BMO Capital Markets in Toronto, Canada. They share a name and nothing else.",
  },
  {
    q: "How can I contact Dan Barclay?",
    a: "Email barclaysd@me.com, or reach out via GitHub (@barclayd), X (@danielbarclay), or LinkedIn (/in/barclayd). Response window is typically 24–72 hours.",
  },
  {
    q: "What is Promptly?",
    a: "Promptly is a B2B SaaS CMS founded by Dan Barclay that lets non-engineers - product managers, domain experts, marketers - author, version and ship the LLM prompts that power production AI features, without going through a code deploy. It is used in production by 100+ companies. Learn more at promptlycms.com.",
  },
  {
    q: "What is KeepFresh?",
    a: "KeepFresh is an iOS app built by Dan Barclay that helps households end food waste by tracking grocery inventory and surfacing expiry alerts. It has 77,000+ downloads and is used daily by hundreds of households. The backend runs on Hono.js on Cloudflare Workers with D1 storage. Learn more at keepfre.sh.",
  },
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "@id": "https://danbarclay.dev/about#faq",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
  about: { "@id": "https://danbarclay.dev/#person" },
};
---

<Base
  title={title}
  description={description}
  pageType="AboutPage"
  jsonLd={faqJsonLd}
  breadcrumbs={[
    { name: "Home", url: "/" },
    { name: "About" },
  ]}
>
  <main
    class="mx-auto flex w-full max-w-[1100px] flex-col gap-12 py-10 sm:gap-16 sm:py-14 lg:gap-20 pl-[max(1rem,env(safe-area-inset-left))] pr-[max(1rem,env(safe-area-inset-right))] sm:pl-[max(2rem,env(safe-area-inset-left))] sm:pr-[max(2rem,env(safe-area-inset-right))] lg:pl-[max(3rem,env(safe-area-inset-left))] lg:pr-[max(3rem,env(safe-area-inset-right))]"
  >
    <SubPageHeader current="about" />

    <HudFrame
      label="ABOUT"
      className="px-6 py-10 sm:px-10 sm:py-14"
    >
      <div class="grid gap-10 md:grid-cols-[220px_1fr] md:gap-14">
        <!-- Left rail: avatar + meta -->
        <div class="flex flex-col items-start gap-4">
          <DuotoneAvatar
            src="/dan-barclay.webp"
            alt="Dan Barclay - engineering leader and founder, London"
            class="w-40 sm:w-52 md:w-[200px]"
          />
          <div class="flex w-40 sm:w-52 md:w-[200px] flex-col gap-1 font-mono text-[10px] uppercase tracking-hud text-[var(--color-mute)]">
            <div class="flex items-center justify-between">
              <span>NAME</span><span class="text-[var(--color-text)]">DAN BARCLAY</span>
            </div>
            <div class="flex items-center justify-between">
              <span>ROLE</span><span class="text-[var(--color-text)]">ENG LEAD</span>
            </div>
            <div class="flex items-center justify-between">
              <span>BASED</span><span class="text-[var(--color-text)]">LON · UK</span>
            </div>
            <div class="flex items-center justify-between">
              <span>YRS</span><span class="text-[var(--color-amber)]">10+</span>
            </div>
          </div>
        </div>

        <!-- Right column: biography -->
        <div class="flex flex-col gap-8">
          <div>
            <div class="mb-4 flex items-center gap-2 font-mono text-[10px] uppercase tracking-hud text-[var(--color-mute)]">
              <span class="h-px w-6 bg-[var(--color-amber)]"></span>
              <span>BIOGRAPHY · DAN BARCLAY</span>
            </div>
            <h1
              class="font-display font-semibold uppercase leading-[0.95] tracking-tight text-[var(--color-text-bright)]"
              style="font-size: clamp(2.25rem, 7.5vw, 4rem);"
            >
              About<br />Dan Barclay
            </h1>
          </div>

          <div class="space-y-5 font-display text-base leading-relaxed text-[var(--color-text)] sm:text-[1.0625rem]">
            <p>
              <strong class="text-[var(--color-text-bright)]">Dan Barclay</strong>
              is an engineering leader, full-stack product engineer and founder
              based in London, United Kingdom. He has spent 10+ years building
              and scaling software for millions of users - across consumer
              marketplaces, B2B SaaS, mobile apps and AI tooling.
            </p>
            <p>
              Today, Dan is focused on building two products of his own:
            </p>
            <ul class="ml-1 space-y-3 text-[var(--color-mute)]">
              <li class="border-l border-[var(--color-amber-dim)] pl-4">
                <a href="/promptly" class="font-semibold text-[var(--color-text-bright)] hover:text-[var(--color-amber-glow)]">Promptly</a>
                - <strong class="text-[var(--color-text-bright)]">the CMS
                powering the next wave of AI development.</strong> A B2B SaaS
                that hands LLM prompts back to the domain experts who write
                them, used in production by 100+ companies. Built in TypeScript
                on a typed prompt-fetching SDK.
              </li>
              <li class="border-l border-[var(--color-amber-dim)] pl-4">
                <a href="/keepfresh" class="font-semibold text-[var(--color-text-bright)] hover:text-[var(--color-amber-glow)]">KeepFresh</a>
                - <strong class="text-[var(--color-text-bright)]">a Swift-built
                iOS app working to end food waste for good.</strong> Tracks
                grocery inventory and surfaces expiry alerts before things
                spoil. 77,000+ downloads, used daily by hundreds of households.
                The async backend runs on Hono.js on Cloudflare Workers with
                D1 storage.
              </li>
            </ul>
            <p>
              His stack of choice runs the gamut: <strong class="text-[var(--color-text-bright)]">TypeScript,
              React, Node, Python, Rust, Swift</strong>, plus a deep working
              focus on <strong class="text-[var(--color-text-bright)]">Large Language Models,
              the Model Context Protocol (MCP)</strong>, and the engineering
              practices needed to ship AI features safely into production.
            </p>
            <p>
              Dan is most motivated by hard problems and the people driven to
              solve them - work where technical vision and product judgement
              have to align with business outcomes to ship something
              mission-critical.
            </p>
          </div>

          <!--
            Disambiguation note - kept in source order for LLMs and Google to
            extract, but hidden visually via .sr-only-seo (no on-screen impact).
            Mirrors the FAQ Q&A so the entity disambiguation reads consistently
            across rendered FAQ + visually-hidden plain prose.
          -->
          <aside class="sr-only-seo">
            Note - disambiguation: This Dan Barclay is a London-based software
            engineer and founder. He is unrelated to Dan Barclay, the retired
            CEO of BMO Capital Markets in Toronto, Canada. They share a name
            and nothing else.
          </aside>
        </div>
      </div>
    </HudFrame>

    <!-- Profile graph: every property Dan controls, cross-linked. -->
    <HudFrame
      label="PROFILES"
      className="px-6 py-10 sm:px-10 sm:py-14"
    >
      <h2 class="font-display text-2xl font-semibold uppercase tracking-tight text-[var(--color-text-bright)] sm:text-3xl">
        Where to find Dan Barclay
      </h2>
      <p class="mt-2 max-w-xl font-mono text-[11px] uppercase tracking-hud text-[var(--color-mute)]">
        Every profile below belongs to the same Dan Barclay - engineering leader, London.
      </p>

      <div class="my-8 h-px w-full bg-[var(--color-rule)]"></div>

      <ul class="grid grid-cols-1 gap-px bg-[var(--color-rule)] sm:grid-cols-2">
        {[
          { label: "GITHUB", code: "github.com/barclayd", href: "https://github.com/barclayd", desc: "Source code and side projects." },
          { label: "TWITTER · X", code: "x.com/danielbarclay", href: "https://x.com/danielbarclay", desc: "Notes, links and updates." },
          { label: "TWEETS", code: "danbarclay.dev/tweets", href: "/tweets", desc: "On-site archive of @danielbarclay." },
          { label: "LINKEDIN", code: "linkedin.com/in/barclayd", href: "https://www.linkedin.com/in/barclayd/", desc: "Career history and credentials." },
          { label: "EMAIL", code: "barclaysd@me.com", href: "mailto:barclaysd@me.com", desc: "Direct contact." },
          { label: "PROMPTLY", code: "promptlycms.com", href: "https://promptlycms.com", desc: "Company / SaaS founded by Dan Barclay." },
          { label: "KEEPFRESH", code: "keepfre.sh", href: "https://keepfre.sh", desc: "iOS app built by Dan Barclay." },
        ].map((l) => (
          <li>
            <a
              href={l.href}
              rel={l.href.startsWith("http") ? "noopener noreferrer me" : "me"}
              target={l.href.startsWith("http") ? "_blank" : undefined}
              class="group flex min-h-[80px] items-center justify-between gap-4 bg-[var(--color-void)] px-4 py-5 transition-colors hover:bg-[rgba(232,154,60,0.04)] sm:px-5 sm:py-6"
            >
              <div class="flex min-w-0 flex-col">
                <span class="font-mono text-[10px] uppercase tracking-hud text-[var(--color-mute)]">
                  {l.label}
                </span>
                <span class="mt-1 truncate font-display text-base uppercase tracking-tight text-[var(--color-text-bright)] group-hover:text-[var(--color-amber-glow)] sm:text-lg">
                  {l.code}
                </span>
                <span class="mt-0.5 font-display text-xs text-[var(--color-mute)]">{l.desc}</span>
              </div>
              <span aria-hidden="true" class="shrink-0 font-mono text-xl text-[var(--color-mute)] transition-transform group-hover:translate-x-1 group-hover:text-[var(--color-amber)]">↗</span>
            </a>
          </li>
        ))}
      </ul>
    </HudFrame>

    <!-- Voice / Intercept - link out to the podcasts archive. -->
    {featuredPodcast && (
      <HudFrame
        label="PODCASTS"
        className="px-6 py-10 sm:px-10 sm:py-14"
      >
        {/* Inline SVG defs scoped to this card so the duotone preview works. */}
        <svg
          width="0"
          height="0"
          aria-hidden="true"
          class="pointer-events-none absolute"
          style="position:absolute; left:-9999px; top:-9999px;"
        >
          <defs>
            <filter id="duotone-amber-about" color-interpolation-filters="sRGB">
              <feColorMatrix
                type="matrix"
                values="0.2126 0.7152 0.0722 0 0
                        0.2126 0.7152 0.0722 0 0
                        0.2126 0.7152 0.0722 0 0
                        0      0      0      1 0"
              />
              <feComponentTransfer>
                <feFuncR type="table" tableValues="0.055 0.910" />
                <feFuncG type="table" tableValues="0.067 0.604" />
                <feFuncB type="table" tableValues="0.078 0.235" />
              </feComponentTransfer>
            </filter>
          </defs>
        </svg>

        <a href="/podcasts" class="voice-card group">
          <div class="voice-card-meta">
            <div class="voice-eyebrow">
              <span class="voice-onair" aria-hidden="true"></span>
              <span>{String(podcastCount).padStart(2, "0")} {podcastCount === 1 ? "EPISODE" : "EPISODES"}</span>
            </div>
            <h2 class="voice-title">
              Podcast Appearances
            </h2>
            <p class="voice-desc">
              Podcast appearances and live calls. Conversations on
              engineering leadership, AI, testing and the messy business
              of shipping software.
            </p>
            <div class="voice-latest">
              <span class="voice-latest-k">LATEST</span>
              <span class="voice-latest-v">
                <span class="voice-show">{featuredPodcast.show.toUpperCase()}</span>
                <span class="voice-sep" aria-hidden="true">·</span>
                <span class="voice-name">{featuredPodcast.title}</span>
              </span>
            </div>
            <span class="voice-cta">
              <span>OPEN PODCASTS</span>
              <span class="voice-cta-arrow" aria-hidden="true">↳</span>
            </span>
          </div>

          <div class="voice-card-art">
            <div class="voice-art">
              <img
                src={featuredPodcast.artworkUrl}
                alt=""
                loading="lazy"
                decoding="async"
                width="300"
                height="300"
                aria-hidden="true"
              />
              <span class="voice-reticle voice-reticle-tl" aria-hidden="true"></span>
              <span class="voice-reticle voice-reticle-tr" aria-hidden="true"></span>
              <span class="voice-reticle voice-reticle-bl" aria-hidden="true"></span>
              <span class="voice-reticle voice-reticle-br" aria-hidden="true"></span>
              <span class="voice-art-tag">FRAME · {String(featuredPodcast.index).padStart(2, "0")}</span>
            </div>
            <div class="voice-wave" aria-hidden="true">
              {Array.from({ length: 24 }).map((_, i) => (
                <span style={`--i:${i}`} />
              ))}
            </div>
          </div>
        </a>
      </HudFrame>
    )}

    <!-- FAQ - pure-prose Q&A, mirrored in FAQPage JSON-LD for AI overviews. -->
    <HudFrame
      label="FAQ"
      className="px-6 py-10 sm:px-10 sm:py-14"
    >
      <h2 class="font-display text-2xl font-semibold uppercase tracking-tight text-[var(--color-text-bright)] sm:text-3xl">
        Dan Barclay - FAQ
      </h2>

      <div class="my-8 h-px w-full bg-[var(--color-rule)]"></div>

      <div class="flex flex-col gap-px bg-[var(--color-rule)]">
        {faqs.map((f, i) => (
          <article class="bg-[var(--color-void)] px-4 py-6 sm:px-6 sm:py-8">
            <div class="flex items-center gap-3 font-mono text-[10px] uppercase tracking-hud text-[var(--color-amber)]">
              <span>Q/{String(i + 1).padStart(2, "0")}</span>
              <span class="h-px flex-1 bg-[var(--color-rule)]" aria-hidden="true" />
            </div>
            <h3 class="mt-3 font-display text-lg font-semibold text-[var(--color-text-bright)] sm:text-xl">
              {f.q}
            </h3>
            <p class="mt-3 max-w-3xl font-display text-base leading-relaxed text-[var(--color-mute)]">
              {f.a}
            </p>
          </article>
        ))}
      </div>
    </HudFrame>

    <SubPageFooter />
  </main>
</Base>

<style>
  /* ============================ PODCAST CARD ============================= */
  .voice-card {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
    position: relative;
    color: inherit;
    text-decoration: none;
  }
  @media (min-width: 768px) {
    .voice-card {
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
      gap: 36px;
      align-items: center;
    }
  }

  .voice-card-meta {
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-width: 0;
  }

  .voice-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-amber);
  }
  .voice-onair {
    display: inline-block;
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: var(--color-amber);
    box-shadow: 0 0 0 1px rgba(232, 154, 60, 0.35),
      0 0 10px rgba(232, 154, 60, 0.55);
    animation: voice-onair 1.6s ease-in-out infinite;
  }
  @keyframes voice-onair {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.45; transform: scale(0.78); }
  }
  @media (prefers-reduced-motion: reduce) {
    .voice-onair { animation: none; }
  }

  .voice-title {
    font-family: var(--font-display);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    color: var(--color-text-bright);
    font-size: clamp(1.75rem, 5vw, 2.5rem);
    line-height: 0.95;
    margin: 0;
    text-wrap: balance;
    transition: color 200ms var(--ease-hud);
  }
  .voice-card:hover .voice-title,
  .voice-card:focus-visible .voice-title {
    color: var(--color-amber-glow);
  }

  .voice-desc {
    margin: 0;
    max-width: 38em;
    font-family: var(--font-display);
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-mute);
  }

  .voice-latest {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 12px 14px;
    border: 1px solid var(--color-rule);
    background: rgba(20, 24, 28, 0.4);
    min-width: 0;
  }
  .voice-latest-k {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-mute);
  }
  .voice-latest-v {
    display: flex;
    align-items: baseline;
    gap: 10px;
    flex-wrap: wrap;
    min-width: 0;
  }
  .voice-show {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-amber);
  }
  .voice-sep { color: var(--color-faint); }
  .voice-name {
    font-family: var(--font-display);
    font-size: 0.9375rem;
    color: var(--color-text-bright);
    line-height: 1.3;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .voice-cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 4px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-amber);
    transition: color 200ms var(--ease-hud);
  }
  .voice-card:hover .voice-cta,
  .voice-card:focus-visible .voice-cta {
    color: var(--color-amber-glow);
  }
  .voice-cta-arrow {
    transition: transform 220ms var(--ease-hud);
  }
  .voice-card:hover .voice-cta-arrow,
  .voice-card:focus-visible .voice-cta-arrow {
    transform: translateX(4px);
  }

  /* Right column - artwork + small waveform. */
  .voice-card-art {
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-width: 0;
  }
  .voice-art {
    position: relative;
    aspect-ratio: 1 / 1;
    width: 100%;
    max-width: 280px;
    margin: 0 auto;
    border: 1px solid var(--color-rule);
    overflow: hidden;
    isolation: isolate;
    box-shadow:
      inset 0 0 0 1px rgba(232, 154, 60, 0.06),
      0 0 28px -10px rgba(0, 0, 0, 0.7);
  }
  .voice-art img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: url(#duotone-amber-about) contrast(1.06) brightness(0.92);
    transform: scale(1.01);
    transition: transform 900ms cubic-bezier(0.22, 1, 0.36, 1),
      filter 400ms ease;
  }
  .voice-card:hover .voice-art img,
  .voice-card:focus-visible .voice-art img {
    transform: scale(1.04);
    filter: url(#duotone-amber-about) contrast(1.12) brightness(1);
  }
  .voice-art::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 2;
    background-image: repeating-linear-gradient(
      to bottom,
      rgba(14, 17, 20, 0) 0,
      rgba(14, 17, 20, 0) 2px,
      rgba(14, 17, 20, 0.4) 3px,
      rgba(14, 17, 20, 0) 4px
    );
    mix-blend-mode: multiply;
    pointer-events: none;
  }
  .voice-art::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    background: radial-gradient(
      ellipse at 50% 40%,
      transparent 55%,
      rgba(0, 0, 0, 0.55) 100%
    );
  }
  .voice-art-tag {
    position: absolute;
    top: 6px;
    left: 6px;
    z-index: 4;
    padding: 3px 6px;
    background: rgba(14, 17, 20, 0.85);
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-amber);
  }

  .voice-reticle {
    position: absolute;
    width: 12px;
    height: 12px;
    z-index: 3;
    pointer-events: none;
  }
  .voice-reticle::before,
  .voice-reticle::after { content: ""; position: absolute; background: var(--color-amber); }
  .voice-reticle::before { width: 100%; height: 1px; }
  .voice-reticle::after  { width: 1px; height: 100%; }
  .voice-reticle-tl { top: -1px; left: -1px; }
  .voice-reticle-tl::before { top: 0; left: 0; }
  .voice-reticle-tl::after  { top: 0; left: 0; }
  .voice-reticle-tr { top: -1px; right: -1px; }
  .voice-reticle-tr::before { top: 0; right: 0; }
  .voice-reticle-tr::after  { top: 0; right: 0; }
  .voice-reticle-bl { bottom: -1px; left: -1px; }
  .voice-reticle-bl::before { bottom: 0; left: 0; }
  .voice-reticle-bl::after  { bottom: 0; left: 0; }
  .voice-reticle-br { bottom: -1px; right: -1px; }
  .voice-reticle-br::before { bottom: 0; right: 0; }
  .voice-reticle-br::after  { bottom: 0; right: 0; }

  /* Tiny waveform under the artwork - bars idle continuously. */
  .voice-wave {
    display: flex;
    align-items: center;
