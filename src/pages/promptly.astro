---
import Product from "../layouts/Product.astro";

const title =
  "Promptly - LLM Prompt CMS · Built by Dan Barclay";
const description =
  "Promptly is a B2B SaaS CMS for LLM prompts, founded by Dan Barclay (engineering leader, London). Used in production by 100+ companies to let domain experts author, version and ship prompts without a code deploy.";

const PERSON_ID = "https://danbarclay.dev/#person";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "@id": "https://danbarclay.dev/promptly#app",
    name: "Promptly",
    alternateName: "Promptly CMS",
    url: "https://promptlycms.com",
    applicationCategory: "DeveloperApplication",
    operatingSystem: "Web",
    description:
      "A B2B SaaS CMS for LLM prompts. Hands prompt authoring back to the domain experts who write them - versioning, releasing and shipping prompts without a code deploy. Used in production by 100+ companies.",
    creator: { "@id": PERSON_ID },
    author: { "@id": PERSON_ID },
    founder: { "@id": PERSON_ID },
    publisher: { "@id": PERSON_ID },
    offers: { "@type": "Offer", category: "SaaS" },
  },
];
---

<Product product="promptly" title={title} description={description} schema={schema} />
