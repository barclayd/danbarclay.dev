---
import Base from "../layouts/Base.astro";
import Cta from "../components/Cta.astro";
import PageIntro from "../components/PageIntro.astro";
import PodcastCard from "../components/PodcastCard.astro";
import podcastsRaw from "../data/podcasts.json";
import type { Podcast } from "../lib/types";

const podcasts = (podcastsRaw as Podcast[]).slice().sort((a, b) => {
  // Featured first, then newest by publishedAt.
  if (a.featured !== b.featured) return a.featured ? -1 : 1;
  return new Date(b.publishedAt).getTime() - new Date(a.publishedAt).getTime();
});

const [hero, ...archive] = podcasts;

const title =
  "Podcasts - Dan Barclay · Appearances and guest spots";
const description =
  "Podcast appearances by Dan Barclay - engineering leader, founder of Promptly and KeepFresh. Guest spots, calls in to other shows, and conversations about engineering, AI, testing and product.";

const PERSON_ID = "https://danbarclay.dev/#person";

const podcastSchema = podcasts.map((p) => ({
  "@context": "https://schema.org",
  "@type": "PodcastEpisode",
  "@id": `https://danbarclay.dev/podcasts#${p.slug}`,
  url: p.spotifyUrl,
  name: p.title,
  datePublished: p.publishedAt,
  timeRequired: `PT${Math.floor(p.durationSeconds / 60)}M`,
  description: p.description,
  image: p.artworkUrl,
  partOfSeries: {
    "@type": "PodcastSeries",
    name: p.show,
    url: p.showUrl,
  },
  associatedMedia: {
    "@type": "MediaObject",
    contentUrl: p.spotifyUrl,
    embedUrl: p.embedUrl,
    encodingFormat: "audio/mpeg",
  },
  contributor: { "@id": PERSON_ID },
  about: { "@id": PERSON_ID },
  inLanguage: "en",
}));

const totalSeconds = podcasts.reduce((sum, p) => sum + p.durationSeconds, 0);
const totalMinutes = Math.round(totalSeconds / 60);
const showCount = new Set(podcasts.map((p) => p.show)).size;
const latestYear = Math.max(
  ...podcasts.map((p) => new Date(p.publishedAt).getUTCFullYear()),
);
---

<Base
  title={title}
  description={description}
  pageType="CollectionPage"
  jsonLd={podcastSchema}
  breadcrumbs={[
    { name: "Home", url: "/" },
    { name: "About", url: "/about" },
    { name: "Podcasts" },
  ]}
>
  <PageIntro
    eyebrow="Podcasts · Appearances"
    title="Podcasts"
    dim="On the mic."
    lead="Guest spots and call-ins by Dan Barclay on engineering, AI, testing and product. Every episode plays right here."
    stats={[
      { label: "Episodes", value: String(podcasts.length), count: podcasts.length },
      { label: "Shows", value: String(showCount), count: showCount },
      { label: "Minutes", value: String(totalMinutes), count: totalMinutes },
      { label: "Latest", value: String(latestYear) },
    ]}
  />

  {
    hero && (
      <section class="featured" aria-label="Featured episode">
        <div class="wrap">
          <PodcastCard podcast={hero} variant="hero" />
        </div>
      </section>
    )
  }

  {
    archive.length > 0 && (
      <section class="section" aria-labelledby="archive-title">
        <div class="wrap">
          <div class="section-head">
            <div class="section-head__title">
              <span class="eyebrow" data-reveal="track">Archive · {archive.length} episodes</span>
              <h2 id="archive-title" class="h2" data-reveal="up">
                More episodes
              </h2>
            </div>
            <p class="section-head__copy" data-reveal="up" data-delay="120">
              Newest first. Open a row to play the episode.
            </p>
          </div>
          <div class="archive" data-reveal="up">
            {archive.map((p) => (
              <PodcastCard podcast={p} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="section invite" aria-labelledby="invite-title">
    <div class="wrap invite__inner">
      <div class="section-head__title">
        <span class="eyebrow" data-reveal="track">Speaking</span>
        <h2 id="invite-title" class="h2" data-reveal="up">Want Dan on your show?</h2>
      </div>
      <p class="body invite__copy" data-reveal="up" data-delay="120">
        Happy to talk engineering leadership, shipping AI products, testing strategy or building apps solo
        alongside a day job.
      </p>
      <div class="cta-row" data-stagger="90" data-delay="200">
        <Cta enquire="speaking" href="mailto:barclaysd@me.com?subject=Podcast%20invite" data-reveal="up">
          Invite Dan
        </Cta>
        <Cta href="/about" variant="secondary" data-reveal="up">About Dan Barclay</Cta>
      </div>
    </div>
  </section>
</Base>

<style>
  .archive {
    border-top: 1px solid var(--color-line-2);
  }

  .invite {
    padding-bottom: clamp(120px, 18vh, 200px);
  }

  .invite__inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 28px;
  }

  .invite__copy {
    max-width: 560px;
    text-wrap: pretty;
  }
</style>
