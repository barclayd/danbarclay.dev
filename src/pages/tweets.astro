---
import Base from "../layouts/Base.astro";
import Cta from "../components/Cta.astro";
import PageIntro from "../components/PageIntro.astro";
import TweetCard from "../components/TweetCard.astro";
import tweetsRaw from "../data/tweets.json";
import type { Tweet } from "../lib/types";


const tweets = (tweetsRaw as Tweet[]).slice().sort((a, b) => {
  // Pinned first, then newest by postedAt.
  if (a.pinned !== b.pinned) return a.pinned ? -1 : 1;
  return new Date(b.postedAt).getTime() - new Date(a.postedAt).getTime();
});

const [hero, ...archive] = tweets;

const title =
  "Tweets - Dan Barclay · On-site archive of @danielbarclay";
const description =
  "An on-site archive of tweets by Dan Barclay - engineering leader, founder of Promptly and KeepFresh. Short posts on engineering, AI, testing, iOS and the messy parts of shipping software.";

const SITE_URL = "https://danbarclay.dev";
const PERSON_ID = `${SITE_URL}/#person`;

const tweetSchema = tweets.map((t) => ({
  "@context": "https://schema.org",
  "@type": "SocialMediaPosting",
  "@id": `${SITE_URL}/tweets/#${t.id}`,
  url: t.url,
  identifier: t.id,
  articleBody: t.text,
  datePublished: t.postedAt,
  author: { "@id": PERSON_ID },
  creator: { "@id": PERSON_ID },
  inLanguage: "en",
  ...(t.media && t.media.length > 0
    ? {
        image: t.media
          .filter((m) => m.type === "image" || m.type === "gif")
          .map((m) => new URL(m.src, SITE_URL).toString()),
      }
    : {}),
  ...(t.metrics
    ? {
        interactionStatistic: [
          {
            "@type": "InteractionCounter",
            interactionType: { "@type": "LikeAction" },
            userInteractionCount: t.metrics.likes,
          },
          {
            "@type": "InteractionCounter",
            interactionType: { "@type": "ShareAction" },
            userInteractionCount: t.metrics.reposts,
          },
          {
            "@type": "InteractionCounter",
            interactionType: { "@type": "ReplyAction" },
            userInteractionCount: t.metrics.replies,
          },
        ],
      }
    : {}),
  isPartOf: { "@id": `${SITE_URL}/tweets/#page` },
}));

const totalPosts = tweets.length;
const totalLikes = tweets.reduce((sum, t) => sum + (t.metrics?.likes ?? 0), 0);
const firstYear = Math.min(new Date().getUTCFullYear(), ...tweets.map((t) => new Date(t.postedAt).getUTCFullYear()));
---

<Base
  title={title}
  description={description}
  pageType="CollectionPage"
  jsonLd={tweetSchema}
  breadcrumbs={[
    { name: "Home", url: "/" },
    { name: "About", url: "/about" },
    { name: "Tweets" },
  ]}
>
  <PageIntro
    eyebrow="Tweets · @danielbarclay"
    title="Tweets"
    dim="Archive."
    lead="An on-site archive of posts by Dan Barclay on engineering, AI, testing, iOS and the messy parts of shipping software. Each card opens the live post on X."
    stats={[
      { label: "Posts", value: String(totalPosts), count: totalPosts },
      { label: "Likes", value: String(totalLikes), count: totalLikes },
      { label: "Since", value: String(firstYear) },
    ]}
  />

  {
    hero ? (
      <section class="featured" aria-label="Featured post">
        <div class="wrap">
          <div class="featured__inner" data-reveal="up">
            <TweetCard tweet={hero} variant="hero" />
          </div>
        </div>
      </section>
    ) : (
      <section class="featured">
        <div class="wrap">
          <p class="body">
            No posts on file yet. New posts are mirrored here from{" "}
            <a class="text-link" href="https://x.com/danielbarclay" target="_blank" rel="noopener me">
              @danielbarclay
            </a>
            .
          </p>
        </div>
      </section>
    )
  }

  {
    archive.length > 0 && (
      <section class="section" aria-labelledby="archive-title">
        <div class="wrap">
          <div class="section-head">
            <div class="section-head__title">
              <span class="eyebrow" data-reveal="track">Archive · {archive.length} posts</span>
              <h2 id="archive-title" class="h2" data-reveal="up">
                Back-catalogue
              </h2>
            </div>
            <p class="section-head__copy" data-reveal="up" data-delay="120">
              Every other post, newest first. Replies and quotes carry the parent inline.
            </p>
          </div>
          <ul class="archive">
            {archive.map((t) => (
              <li data-reveal="up">
                <TweetCard tweet={t} />
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <section class="section follow" aria-labelledby="follow-title">
    <div class="wrap follow__inner">
      <div class="section-head__title">
        <span class="eyebrow" data-reveal="track">The live feed</span>
        <h2 id="follow-title" class="h2" data-reveal="up">Follow on X</h2>
      </div>
      <p class="body follow__copy" data-reveal="up" data-delay="120">
        This page is a curated mirror. The live feed, replies and conversations happen on X.
      </p>
      <div class="cta-row" data-stagger="90" data-delay="200">
        <Cta href="https://x.com/danielbarclay" external rel="noopener me" data-reveal="up">
          Follow @danielbarclay
        </Cta>
        <Cta href="/about" variant="secondary" data-reveal="up">About Dan Barclay</Cta>
      </div>
    </div>
  </section>
</Base>

<style>
  .featured__inner {
    max-width: 1040px;
  }

  .archive {
    columns: 2 420px;
    column-gap: 20px;
  }

  .archive > li {
    break-inside: avoid;
    margin-bottom: 20px;
  }

  .follow {
    padding-bottom: clamp(120px, 18vh, 200px);
  }

  .follow__inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 28px;
  }

  .follow__copy {
    max-width: 560px;
    text-wrap: pretty;
  }
</style>
