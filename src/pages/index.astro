<script>
  // The reel only plays while it's on screen, and never under reduced motion.
  const video = document.querySelector<HTMLVideoElement>("[data-hero-video]");
  if (video) {
    const reduced = matchMedia("(prefers-reduced-motion: reduce)");
    let onScreen = true;
    const sync = () => (onScreen && !reduced.matches ? video.play().catch(() => {}) : video.pause());
    new IntersectionObserver(([e]) => {
      onScreen = e.isIntersecting;
      sync();
    }).observe(video);
    reduced.addEventListener("change", sync);
  }

  // Rail labels jump to their panel; without JS they link to the product page.
  const seq = document.querySelector<HTMLElement>("[data-sequence]");
  seq?.addEventListener("click", (e) => {
    const a = (e.target as Element).closest<HTMLElement>("[data-seq-jump]");
    if (!a) return;
    e.preventDefault();
    const panels = seq.querySelectorAll("[data-seq-panel]").length;
    const range = seq.offsetHeight - innerHeight;
    const top = seq.getBoundingClientRect().top + scrollY;
    scrollTo({ top: top + (range * +a.dataset.seqJump!) / Math.max(1, panels - 1), behavior: "smooth" });
  });

  // On narrow screens the heatmap scrolls sideways; start at the latest week.
  const heat = document.querySelector<HTMLElement>("[data-heat-scroll]");
  if (heat) heat.scrollLeft = heat.scrollWidth;
</script>
