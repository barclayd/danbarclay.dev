---
import Base from "../layouts/Base.astro";
import IdentityPanel from "../components/IdentityPanel.astro";
import HeatmapPanel from "../components/HeatmapPanel.astro";
import ProjectsPanel from "../components/ProjectsPanel.astro";
import CommsPanel from "../components/CommsPanel.astro";
---

<Base pageType="ProfilePage">
  <!--
    Canonical entity statement. Rendered visually-hidden but fully present in
    source order — this is the sentence LLM crawlers will extract as the
    factoid summary for "Who is Dan Barclay?" queries.
  -->
  <p class="sr-only-seo">
    Dan Barclay is an engineering leader and founder based in London, United Kingdom.
    He has 10+ years of experience building product and AI experiences for millions
    of users, and is focused on building Promptly — the CMS powering the next wave
    of AI development, used in production by 100+ companies — and KeepFresh, an iOS
    app working to end food waste for good, with 77,000+ downloads. He is not
    affiliated with the BMO Capital Markets executive of the same name.
  </p>

  <main
    class="mx-auto flex w-full max-w-[1400px] flex-col gap-12 py-10 sm:gap-16 sm:py-14 lg:gap-20 pl-[max(1rem,env(safe-area-inset-left))] pr-[max(1rem,env(safe-area-inset-right))] sm:pl-[max(2rem,env(safe-area-inset-left))] sm:pr-[max(2rem,env(safe-area-inset-right))] lg:pl-[max(3rem,env(safe-area-inset-left))] lg:pr-[max(3rem,env(safe-area-inset-right))]"
  >
    <!-- Top system rail -->
    <header
      class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2 font-mono text-[10px] uppercase tracking-hud text-[var(--color-mute)]"
    >
      <div class="flex items-center gap-2">
        <span class="inline-block h-1.5 w-1.5 bg-[var(--color-amber)]"></span>
        <span>DANBARCLAY.DEV<span class="hidden sm:inline"> · TERMINAL/00</span></span>
      </div>
      <!-- Compact mobile site nav -->
      <nav
        aria-label="Site"
        class="flex items-center gap-2 sm:hidden"
      >
        <a
          href="/about/"
          class="rounded-sm px-1 py-0.5 hover:text-[var(--color-amber-glow)]"
        >ABOUT</a>
        <span class="text-[var(--color-rule-strong)]">·</span>
        <a
          href="/work/"
          class="rounded-sm px-1 py-0.5 hover:text-[var(--color-amber-glow)]"
        >WORK</a>
      </nav>
      <!-- Full site nav -->
      <nav aria-label="Site" class="hidden gap-4 sm:flex">
        <a href="/about/" class="hover:text-[var(--color-amber-glow)]">ABOUT</a>
        <a href="/work/" class="hover:text-[var(--color-amber-glow)]">WORK</a>
        <a href="/promptly/" class="hover:text-[var(--color-amber-glow)]">PROMPTLY</a>
        <a href="/keepfresh/" class="hover:text-[var(--color-amber-glow)]">KEEPFRESH</a>
      </nav>
      <div>
        <span>STATUS · NOMINAL</span>
      </div>
    </header>

    <section id="identity"><IdentityPanel /></section>
    <section id="signal"><HeatmapPanel /></section>
    <section id="trans"><ProjectsPanel /></section>
    <section id="comms"><CommsPanel /></section>
  </main>
</Base>
