---
import Base from "../layouts/Base.astro";
import Cta from "../components/Cta.astro";
import contributionsRaw from "../data/contributions.json";
import { HEAT_LEVELS, PRODUCT_LIST, buildActivity, shotFor } from "../lib/products";
import type { ContributionsData } from "../lib/types";
import { REEL } from "../lib/reel";

const reelSchema = {
  "@context": "https://schema.org",
  "@type": "VideoObject",
  name: "Dan Barclay - Showreel",
  description: REEL.description,
  thumbnailUrl: `${REEL.base}/reel-poster.jpg`,
  contentUrl: `${REEL.base}/reel-1080.mp4`,
  uploadDate: REEL.uploadDate,
  duration: `PT${REEL.duration}S`,
  creator: { "@id": "https://danbarclay.dev/#person" },
};

const act = buildActivity(contributionsRaw as ContributionsData);
const fmt = (n: number, dec = 0) =>
  n.toLocaleString("en-GB", { minimumFractionDigits: dec, maximumFractionDigits: dec });

const NAME = ["DAN", "BARCLAY"];

const heroStats = [
  { value: 10, suffix: "+", label: "Years shipping", delay: 1350 },
  { value: 100, suffix: "+", label: "Companies on Promptly", delay: 1450 },
  { value: 77, suffix: "K+", label: "KeepFresh downloads", delay: 1550 },
  { value: act.k, suffix: "K", decimals: 1, label: "Contributions · 12 mo", delay: 1650 },
];

const activityStats = [
  { value: act.total, label: "Total contributions" },
  { value: act.avg, decimals: 1, label: "Average per day" },
  { value: act.peak, label: "Busiest day" },
  { value: act.streak, suffix: " days", label: "Longest streak" },
];

const panels = PRODUCT_LIST.map((p) => ({ ...p, img: shotFor(p.key, "bg") }));

const profiles = [
  { label: "GitHub", value: "barclayd", href: "https://github.com/barclayd" },
  { label: "X", value: "@danielbarclay", href: "https://x.com/danielbarclay" },
  { label: "LinkedIn", value: "in/barclayd", href: "https://www.linkedin.com/in/barclayd/" },
  { label: "Email", value: "barclaysd@me.com", href: "mailto:barclaysd@me.com" },
];
---

<Base pageType="ProfilePage" jsonLd={reelSchema} active="home">
  <!--
    Canonical entity statement. Rendered visually-hidden but fully present in
    source order - this is the sentence LLM crawlers will extract as the
    factoid summary for "Who is Dan Barclay?" queries.
  -->
  <p class="sr-only-seo">
    Dan Barclay is an engineering leader and founder based in London, United Kingdom.
    He has 10+ years of experience building product and AI experiences for millions
    of users, and is focused on building Promptly - the CMS powering the next wave
    of AI development, used in production by 100+ companies - KeepFresh, an iOS
    app working to end food waste for good, with 77,000+ downloads - Stitch, a
    free web app that combines split Strava rides into one activity - and On Air,
    a free-forever Wispr Flow alternative for Mac. He is not
    affiliated with the BMO Capital Markets executive of the same name.
  </p>

  <!-- ====== Hero: the showreel runs full-bleed behind the name ====== -->
  <section class="hero">
    <div class="hero__media" aria-hidden="true" data-reveal="scale" data-delay="250" data-dur="2800">
      <video
        class="hero__video"
        src={`${REEL.base}/reel-720.mp4`}
        poster={`${REEL.base}/reel-poster.jpg`}
        muted
        autoplay
        loop
        playsinline
        preload="auto"
        disablepictureinpicture
        data-hero-video></video>
    </div>
    <div class="hero__scrim" aria-hidden="true"></div>
    <div class="hero__content">
      <div class="hero__head">
        <span class="eyebrow hero__eyebrow" data-reveal="track" data-delay="650">
          Engineering leader · Founder · London
        </span>
        <h1 class="hero__name" aria-label="Dan Barclay" data-stagger="48" data-delay="450">
          {
            NAME.map((word) => (
              <span class="hero__word" aria-hidden="true">
                {[...word].map((l) => (
                  <span data-reveal="rise">{l}</span>
                ))}
              </span>
            ))
          }
        </h1>
        <p class="lead hero__lead" data-reveal="up" data-delay="1100">
          Ten years shipping product and AI experiences to millions of people. Now building four products of my own.
        </p>
      </div>
      <div class="hero__foot">
        <dl class="hero__stats" data-stagger="110" data-delay="1250">
          {
            heroStats.map((s) => (
              <div class="hero__stat" data-reveal="up">
                <dt class="stat-label">{s.label}</dt>
                <dd
                  class="num hero__num"
                  data-count={s.value}
                  data-suffix={s.suffix}
                  data-decimals={s.decimals}
                  data-delay={s.delay}
                >
                  {fmt(s.value, s.decimals) + (s.suffix ?? "")}
                </dd>
              </div>
            ))
          }
        </dl>
        <div class="cta-row hero__ctas" data-stagger="90" data-delay="1700">
          <Cta enquire data-reveal="up">Work with me</Cta>
          <Cta href="#products" variant="secondary" data-reveal="up">Explore products</Cta>
        </div>
      </div>
    </div>
  </section>

  <!-- ====== Products: a pinned stage that swaps panels as you scroll ====== -->
  <section id="products" class="seq" data-sequence aria-labelledby="seq-title">
    <h2 id="seq-title" class="sr-only-seo">Four products</h2>
    <div class="seq__stage">
      <ol class="seq__rail">
        {
          panels.map((p, i) => (
            <li>
              <a
                href={p.href}
                class="seq__label"
                style={`--accent:${p.accent};--on:${i ? 0 : 1}`}
                data-seq-label={i}
                data-seq-jump={i}
                data-no-curtain
                aria-label={p.name}
              >
                <span class="seq__track" aria-hidden="true">
                  <span class="seq__fill" data-seq-bar={i} />
                </span>
                <span class="seq__tag">
                  <span class="seq__dot" aria-hidden="true" />
                  <span class="seq__lname">{p.name}</span>
                </span>
              </a>
            </li>
          ))
        }
      </ol>

      {
        panels.map((p, i) => (
          <article
            class="seq__panel"
            style={`--accent:${p.accent};${i ? "--vis:0;--x:1;--dir:1;visibility:hidden" : "--vis:1;--x:0;--dir:0"}`}
            data-seq-panel={i}
            aria-labelledby={`seq-${p.key}`}
          >
            <div class="seq__img" aria-hidden="true">
              {p.img ? (
                <img src={p.img} alt="" width="1920" height="1080" loading="lazy" decoding="async" style={`object-position:${p.shotFocus}`} />
              ) : (
                <div class="seq__ph" />
              )}
            </div>
            <div class="seq__scrim" aria-hidden="true" />
            <div class:list={["seq__glow-wrap", i % 2 ? "is-right" : "is-left"]} aria-hidden="true">
              <div class="glow seq__glow" style={`--glow-color:${p.accent}`} data-loop="breathe" />
            </div>
            <div class="wrap seq__content">
              <span class="eyebrow seq__eyebrow">
                <span class="dot" aria-hidden="true" />
                {p.n} / 04 · {p.seq.category}
              </span>
              <h3 id={`seq-${p.key}`} class="seq__name" style={`--chars:${p.name.length}`}>
                {p.name}
              </h3>
              <div class="seq__row">
                <p class="seq__copy">{p.seq.copy}</p>
                <dl class="seq__stats">
                  {p.seq.stats.map(([value, label]) => (
                    <div class="seq__stat">
                      <dt class="stat-label">{label}</dt>
                      <dd class="num seq__num">{value}</dd>
                    </div>
                  ))}
                </dl>
              </div>
              <div class="cta-row seq__ctas">
                <Cta href={p.href} accent={p.accent}>
                  Explore {p.name}
                </Cta>
                <Cta href={p.site} external variant="secondary">
                  {p.siteLabel}
                </Cta>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <!-- ====== Activity: twelve months of GitHub contributions ====== -->
  <section id="activity" class="section">
    <div class="wrap">
      <div class="section-head">
        <div class="section-head__title">
          <span class="eyebrow" data-reveal="track">Activity · GitHub</span>
          <h2 class="h2" data-reveal="up">Built daily</h2>
        </div>
        <p class="section-head__copy" data-reveal="up" data-delay="120">
          Every contribution from the last twelve months, pulled straight from GitHub.
        </p>
      </div>

      <dl class="act__stats" data-stagger="100">
        {
          activityStats.map((s) => (
            <div class="act__stat" data-reveal="up">
              <dt class="stat-label">{s.label}</dt>
              <dd class="num act__num" data-count={s.value} data-decimals={s.decimals} data-suffix={s.suffix}>
                {fmt(s.value, s.decimals) + (s.suffix ?? "")}
              </dd>
            </div>
          ))
        }
      </dl>

      <div class="heat" data-heat-scroll>
        <div
          class="heat__inner"
          role="img"
          aria-label={`GitHub contributions over the last twelve months: ${fmt(act.total)} in total, ${act.peak} on the busiest day.`}
        >
          <div class="heat__months" style={`--cols:${act.cols}`} aria-hidden="true">
            {act.months.map((m) => <span style={`grid-column:${m.col}`}>{m.label}</span>)}
          </div>
          <div class="heat__grid" aria-hidden="true">
            {
              act.cells.map((c) =>
                c ? (
                  <div
                    class="heat__cell"
                    style={`background:${HEAT_LEVELS[c.level] ?? HEAT_LEVELS[0]}`}
                    title={c.title}
                    data-reveal="cell"
                    data-delay={c.delay}
                  />
                ) : (
                  <div class="heat__cell heat__cell--pad" />
                ),
              )
            }
          </div>
        </div>
      </div>

      <div class="heat__foot">
        <div class="heat__legend" aria-hidden="true">
          Less
          {HEAT_LEVELS.map((bg) => <span style={`background:${bg}`} />)}
          More
        </div>
        <a href="https://github.com/barclayd" target="_blank" rel="noopener" class="text-link">github.com/barclayd</a>
      </div>
    </div>
  </section>

  <!-- ====== Contact ====== -->
  <section id="contact" class="contact">
    <div class="contact__glow-wrap" aria-hidden="true">
      <div class="glow contact__glow" data-loop="breathe"></div>
    </div>
    <div class="wrap contact__inner">
      <span class="eyebrow" data-reveal="track">Contact</span>
      <h2 class="contact__title">
        <span class="line-mask"><span data-reveal="rise">Let's build</span></span>
        <span class="line-mask"><span data-reveal="rise" data-delay="120">something</span></span>
      </h2>
      <p class="body contact__copy" data-reveal="up" data-delay="200">
        I'm motivated by hard problems and the people driven to solve them. Expect a reply within 24 hours.
      </p>
      <div class="cta-row contact__ctas" data-stagger="90" data-delay="280">
        <Cta enquire data-reveal="up">Work with me</Cta>
        <Cta href="mailto:barclaysd@me.com" variant="secondary" data-reveal="up">Email me</Cta>
      </div>
      <ul class="contact__links" data-stagger="80">
        {
          profiles.map((l) => (
            <li data-reveal="up">
              <a
                href={l.href}
                class="contact__link"
                target={l.href.startsWith("http") ? "_blank" : undefined}
                rel={l.href.startsWith("http") ? "noopener" : undefined}
              >
                <span class="contact__label">{l.label}</span>
                <span class="contact__value">{l.value}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<style>
  /* ====== Hero ====== */
  .hero {
    position: relative;
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    isolation: isolate;
  }

  .hero__media {
    position: absolute;
    inset: 0;
    z-index: -2;
  }

  .hero__video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.42;
  }

  .hero__scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      180deg,
      rgba(8, 9, 11, 0.9) 0%,
      rgba(8, 9, 11, 0.15) 28%,
      rgba(8, 9, 11, 0.25) 58%,
      rgba(8, 9, 11, 0.96) 100%
    );
  }

  .hero__content {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    gap: 56px;
    padding: calc(64px + 11vh) clamp(20px, 4vw, 64px) max(clamp(28px, 5vh, 56px), env(safe-area-inset-bottom));
    text-align: center;
  }

  .hero__head {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 26px;
  }

  .hero__eyebrow {
    color: var(--color-muted);
    letter-spacing: 0.28em;
  }

  .hero__name {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    column-gap: 0.36em;
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(40px, 8vw, 164px);
    line-height: 1;
    letter-spacing: 0.02em;
  }

  .hero__word {
    display: inline-flex;
    overflow: hidden;
    padding: 0.08em 0 0.04em;
  }

  .hero__word > span {
    display: inline-block;
  }

  .hero__lead {
    max-width: 600px;
    text-wrap: pretty;
  }

  .hero__foot {
    width: 100%;
    max-width: 1180px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 40px;
  }

  .hero__stats {
    width: 100%;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 150px), 1fr));
    row-gap: 28px;
  }

  .hero__stat {
    display: flex;
    flex-direction: column-reverse;
    align-items: center;
    gap: 12px;
    padding: 0 16px;
  }

  .hero__stat + .hero__stat {
    border-left: 1px solid var(--color-line-4);
  }

  .hero__num {
    font-size: clamp(40px, 4.6vw, 76px);
    min-height: 1em;
  }

  .hero__stat .stat-label {
    font-size: 12px;
  }

  .hero__ctas {
    justify-content: center;
  }

  /* Phones: a 2 × 2 stat grid, with dividers only between the columns. */
  @media (max-width: 699px) {
    .hero__content {
      gap: 44px;
      padding-top: calc(64px + 7vh);
    }

    .hero__stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 24px;
    }

    .hero__stat {
      padding: 0 8px;
    }

    .hero__stat:nth-child(odd) {
      border-left: 0;
    }

    .hero__num {
      font-size: clamp(34px, 10vw, 44px);
    }

    .hero__stat .stat-label {
      font-size: 11px;
      letter-spacing: 0.16em;
    }
  }

  /* ====== Products sequence ====== */
  .seq {
    position: relative;
    height: calc(4 * 120vh);
  }

  /* svh, so the rail and CTAs at the bottom clear mobile browser chrome. */
  .seq__stage {
    --rail-bottom: max(clamp(16px, 3vh, 32px), env(safe-area-inset-bottom));
    --rail-h: 35px;
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
    background: var(--color-bg);
  }

  /* Along the bottom edge, clear of the nav. */
  .seq__rail {
    position: absolute;
    bottom: var(--rail-bottom);
    left: 0;
    right: 0;
    z-index: 5;
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 clamp(20px, 4vw, 64px);
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 8px;
    list-style: none;
  }

  .seq__label {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-bottom: 6px;
    opacity: calc(0.45 + var(--on) * 0.55);
  }

  .seq__track {
    position: relative;
    height: 2px;
    background: var(--color-line-4);
    overflow: hidden;
  }

  .seq__fill {
    position: absolute;
    inset: 0;
    background: var(--accent);
    transform: scaleX(var(--fill, 0));
    transform-origin: left;
  }

  .seq__tag {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-ink);
    white-space: nowrap;
  }

  .seq__dot {
    flex: none;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }

  .seq__panel {
    position: absolute;
    inset: 0;
    opacity: var(--vis);
  }

  /* The whole shot, framed under the nav against the right edge of the
     content column, instead of a full-bleed crop that runs off both sides.
     Capped by height so short screens keep all of it, and faded out before
     the copy so it never sits under the eyebrow or name at full strength. */
  .seq__img {
    position: absolute;
    top: calc(64px + clamp(16px, 4vh, 48px));
    right: calc(max(0px, (100vw - 1440px) / 2) + clamp(20px, 4vw, 64px));
    width: min(960px, calc(100vw - 2 * clamp(20px, 4vw, 64px)), 100svh);
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: clamp(10px, 1.2vw, 18px);
    opacity: 0.7;
    transform: scale(calc(1.06 - var(--vis) * 0.06));
    transform-origin: right top;
    mask-image: linear-gradient(180deg, #000 30%, transparent 85%);
  }

  .seq__img img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .seq__ph {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(70% 60% at 72% 30%, color-mix(in oklch, var(--accent) 34%, transparent), transparent 70%),
      linear-gradient(rgba(255, 255, 255, 0.05) 1px, transparent 1px) 0 0 / 100% 12.5%,
      linear-gradient(90deg, rgba(255, 255, 255, 0.05) 1px, transparent 1px) 0 0 / 6.25% 100%;
  }

  .seq__scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(0deg, #08090b 0%, rgba(8, 9, 11, 0.82) 34%, rgba(8, 9, 11, 0.1) 74%),
      linear-gradient(180deg, rgba(8, 9, 11, 0.9) 0%, rgba(8, 9, 11, 0) 64px);
  }

  .seq__glow-wrap {
    position: absolute;
    bottom: -55vw;
    width: 95vw;
    height: 95vw;
    opacity: 0.3;
    pointer-events: none;
  }

  .seq__glow-wrap.is-left {
    left: -30vw;
  }

  .seq__glow-wrap.is-right {
    right: -30vw;
  }

  .seq__glow {
    inset: 0;
  }

  .seq__content {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    flex-direction: column;
    gap: clamp(16px, 3vh, 28px);
    padding-bottom: calc(var(--rail-bottom) + var(--rail-h) + clamp(24px, 5vh, 56px));
  }

  .seq__eyebrow {
    color: var(--color-ink-3);
    transform: translate3d(0, calc(var(--dir) * -40px), 0);
  }

  .seq__name {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: min(clamp(34px, 10vw, 196px), calc((100vw - 2 * clamp(20px, 4vw, 64px)) / var(--chars) / 0.96));
    line-height: 1;
    text-transform: uppercase;
    white-space: nowrap;
    letter-spacing: calc(0.01em + var(--x) * 0.22em);
    filter: blur(calc(var(--x) * 14px));
    transform: translate3d(0, calc(var(--dir) * -90px), 0);
  }

  .seq__row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px 48px;
    transform: translate3d(0, calc(var(--dir) * -150px), 0);
  }

  .seq__copy {
    max-width: 520px;
    font-size: 17px;
    line-height: 1.6;
    color: var(--color-ink-2);
    text-wrap: pretty;
  }

  .seq__stats {
    display: flex;
    flex-wrap: wrap;
    gap: 24px 40px;
  }

  .seq__stat {
    display: flex;
    flex-direction: column-reverse;
    gap: 10px;
  }

  .seq__num {
    font-size: clamp(30px, 3.4vw, 52px);
  }

  .seq__ctas {
    transform: translate3d(0, calc(var(--dir) * -190px), 0);
  }

  /* Phones: just the coloured dots in the rail, a compact stat row and
     tighter copy so a whole panel fits a short screen. */
  @media (max-width: 639px) {
    .seq__lname {
      display: none;
    }

    /* The shot takes whatever height the copy leaves under the nav, so it
       shrinks rather than slide under the text when browser chrome eats into
       the viewport. */
    .seq__panel {
      display: flex;
      flex-direction: column;
    }

    .seq__img {
      position: relative;
      top: auto;
      right: auto;
      flex: 1 1 0;
      min-height: 0;
      width: auto;
      aspect-ratio: auto;
      margin: calc(64px + 12px) clamp(20px, 4vw, 64px) 16px;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: visible;
      border-radius: 0;
      mask-image: none;
      transform-origin: center;
      container-type: size;
    }

    .seq__img img {
      width: auto;
      height: auto;
      max-width: 100%;
      max-height: 100%;
      border-radius: 10px;
      mask-image: linear-gradient(180deg, #000 55%, transparent);
    }

    /* Too little room to read as a picture; drop it rather than show a speck. */
    @container (max-height: 96px) {
      .seq__img img {
        display: none;
      }
    }

    .seq__content {
      position: relative;
      flex: none;
      gap: 14px;
      padding-bottom: calc(var(--rail-bottom) + var(--rail-h) + 20px);
    }

    .seq__copy {
      font-size: 15px;
      line-height: 1.55;
    }

    .seq__stats {
      width: 100%;
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 12px;
    }

    .seq__stat {
      gap: 6px;
    }

    .seq__stat .stat-label {
      font-size: 10px;
      letter-spacing: 0.14em;
    }

    .seq__num {
      font-size: 26px;
    }

    .seq__ctas :global(.cta) {
      height: 50px;
    }

    /* With 14px between layers, the desktop offsets slide them over each
       other mid-fade; keep each step under the gap. */
    .seq__eyebrow {
      transform: translate3d(0, calc(var(--dir) * -12px), 0);
    }

    .seq__name {
      transform: translate3d(0, calc(var(--dir) * -24px), 0);
    }

    .seq__row {
      transform: translate3d(0, calc(var(--dir) * -36px), 0);
    }

    .seq__ctas {
      transform: translate3d(0, calc(var(--dir) * -48px), 0);
    }
  }

  /* Without JS the panels simply stack. */
  :global(html:not(.js)) .seq {
    height: auto;
  }

  :global(html:not(.js)) .seq__stage {
    --rail-h: 0px;
    position: relative;
    height: auto;
  }

  :global(html:not(.js)) .seq__rail {
    display: none;
  }

  /* !important beats the inline start state that hides panels 2-4. */
  :global(html:not(.js)) .seq__panel {
    --vis: 1 !important;
    --x: 0 !important;
    --dir: 0 !important;
    position: relative;
    min-height: 100svh;
    visibility: visible !important;
  }

  /* ====== Activity ====== */
  .act__stats {
