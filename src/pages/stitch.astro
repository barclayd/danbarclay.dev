---
import Base from "../layouts/Base.astro";
import HudFrame from "../components/HudFrame.astro";
import SubPageHeader from "../components/SubPageHeader.astro";
import SubPageFooter from "../components/SubPageFooter.astro";
import LiveSiteIntercept from "../components/LiveSiteIntercept.astro";

const title =
  "Stitch - Combine Split Strava Rides · Built by Dan Barclay";
const description =
  "Stitch is a free web app built by Dan Barclay (engineering leader, London) that combines split Strava rides into one activity. Preview the route and gaps, download a merged GPX, then explicitly confirm the upload. Never deletes activities.";

const PERSON_ID = "https://danbarclay.dev/#person";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "@id": "https://danbarclay.dev/stitch#app",
    name: "Stitch",
    alternateName: "Strava Stitch",
    url: "https://stravastitch.com",
    applicationCategory: "SportsApplication",
    operatingSystem: "Web",
    description:
      "A free web app that combines two or more split Strava rides into a single activity. Preview the route and gaps, download a merged GPX and backups, then explicitly confirm the upload. Never deletes activities. Built in TypeScript with Remix 3 on Cloudflare Workers and Durable Objects.",
    offers: { "@type": "Offer", price: "0", priceCurrency: "GBP" },
    creator: { "@id": PERSON_ID },
    author: { "@id": PERSON_ID },
    founder: { "@id": PERSON_ID },
    publisher: { "@id": PERSON_ID },
  },
];

const facts = [
  { k: "TYPE", v: "FREE WEB APP · STRAVA" },
  { k: "FOUNDER", v: "DAN BARCLAY" },
  { k: "STACK", v: "TYPESCRIPT · REMIX 3 · CF WORKERS" },
  { k: "STATUS", v: "LAUNCHED SEP 2026" },
  { k: "WEB", v: "STRAVASTITCH.COM" },
];
---

<Base
  title={title}
  description={description}
  pageType="WebPage"
  jsonLd={schema}
  breadcrumbs={[
    { name: "Home", url: "/" },
    { name: "Work", url: "/work" },
    { name: "Stitch" },
  ]}
>
  <main
    class="mx-auto flex w-full max-w-[1100px] flex-col gap-12 py-10 sm:gap-16 sm:py-14 lg:gap-20 pl-[max(1rem,env(safe-area-inset-left))] pr-[max(1rem,env(safe-area-inset-right))] sm:pl-[max(2rem,env(safe-area-inset-left))] sm:pr-[max(2rem,env(safe-area-inset-right))] lg:pl-[max(3rem,env(safe-area-inset-left))] lg:pr-[max(3rem,env(safe-area-inset-right))]"
  >
    <SubPageHeader current="stitch" />

    <HudFrame
      label="STITCH"
      index="LIVE"
      className="px-6 py-10 sm:px-10 sm:py-14"
    >
      <div class="mb-4 flex items-center gap-2 font-mono text-[10px] uppercase tracking-hud text-[var(--color-mute)]">
        <span class="h-px w-6 bg-[var(--color-amber)]"></span>
        <span>PROJECT · 03 · BY DAN BARCLAY</span>
      </div>
      <h1
        class="font-display font-semibold uppercase leading-[0.95] tracking-tight text-[var(--color-text-bright)]"
        style="font-size: clamp(2.5rem, 9vw, 5rem);"
      >
        Stitch
      </h1>
      <p class="mt-6 max-w-2xl font-display text-base leading-relaxed text-[var(--color-mute)] sm:text-lg">
        <strong class="text-[var(--color-text-bright)]">Stitch</strong> is a
        free web app built and operated by{" "}
        <a href="/about" class="text-[var(--color-amber)] hover:text-[var(--color-amber-glow)]">Dan Barclay</a>{" "}
        that combines split Strava rides into one activity. Preview the route
        and the gaps, download a merged GPX and backups, then explicitly
        confirm the upload. It never deletes an activity.
      </p>

      <div class="my-10 h-px w-full bg-[var(--color-rule)]"></div>

      {/* Live mirrored feed of stravastitch.com - windscreen-HUD intercept. */}
      <div class="mt-2 mb-4 flex items-center gap-2 font-mono text-[10px] uppercase tracking-hud text-[var(--color-mute)]">
        <span class="h-px w-6 bg-[var(--color-amber)]"></span>
        <span>LIVE PREVIEW</span>
      </div>
      <LiveSiteIntercept
        id="stitch"
        src="https://stravastitch.com"
        host="STRAVASTITCH.COM"
        signal="STITCH · LIVE SITE"
        ctaLabel="ENTER LIVE INSTANCE"
      />

      <div class="my-10 h-px w-full bg-[var(--color-rule)]"></div>

      <div class="grid grid-cols-2 gap-px bg-[var(--color-rule)] sm:grid-cols-5">
        {facts.map((f) => (
          <div class="bg-[var(--color-void)] px-3 py-3">
            <div class="font-mono text-[9px] uppercase tracking-hud text-[var(--color-mute)]">{f.k}</div>
            <div class="mt-1 font-mono text-[11px] uppercase text-[var(--color-text)]">{f.v}</div>
          </div>
        ))}
      </div>

      <div class="mt-12 grid gap-10 md:grid-cols-2">
        <div>
          <h2 class="font-display text-xl font-semibold uppercase tracking-tight text-[var(--color-text-bright)] sm:text-2xl">
            Problem
          </h2>
          <p class="mt-4 font-display text-base leading-relaxed text-[var(--color-mute)]">
            Rides get split. A café stop, a dead battery, a device that
            drops the recording halfway up the climb - and one ride lands on
            Strava as two or three fragments. Strava has no way to join them,
            and the existing workarounds mean hand-editing GPX files and
            hoping the timestamps survive.
          </p>
        </div>
        <div>
          <h2 class="font-display text-xl font-semibold uppercase tracking-tight text-[var(--color-text-bright)] sm:text-2xl">
            Solution
          </h2>
          <p class="mt-4 font-display text-base leading-relaxed text-[var(--color-mute)]">
            Connect Strava, pick two to eight rides, and Stitch previews the
            joined route with every gap left visible. Timestamps, GPS,
            elevation, heart rate and cadence are preserved. Download the
            merged GPX and a backup of the originals, then confirm the upload
            in one explicit step. Stitch never deletes anything on Strava.
          </p>
        </div>
      </div>

      <div class="mt-12 grid gap-10 md:grid-cols-2">
        <div>
          <h2 class="font-display text-xl font-semibold uppercase tracking-tight text-[var(--color-text-bright)] sm:text-2xl">
            Stack
          </h2>
          <ul class="mt-4 space-y-2 font-display text-base leading-relaxed text-[var(--color-mute)]">
            <li>· TypeScript · Remix 3</li>
            <li>· Cloudflare Workers · Durable Objects (SQLite)</li>
            <li>· Strava OAuth + webhooks</li>
            <li>· Encrypted per-athlete storage, previews purged after 24h</li>
          </ul>
        </div>
        <div>
          <h2 class="font-display text-xl font-semibold uppercase tracking-tight text-[var(--color-text-bright)] sm:text-2xl">
            Author
          </h2>
          <p class="mt-4 font-display text-base leading-relaxed text-[var(--color-mute)]">
            <a href="/about" class="text-[var(--color-text-bright)] hover:text-[var(--color-amber-glow)]">Dan Barclay</a>{" "}
            is an engineering leader based in London. Stitch - a free web app
            that combines split Strava rides into one activity - is one of
            four products he is focused on building. The others are{" "}
            <a href="/promptly" class="text-[var(--color-text-bright)] hover:text-[var(--color-amber-glow)]">Promptly</a>,
            the CMS powering the next wave of AI development,{" "}
            <a href="/keepfresh" class="text-[var(--color-text-bright)] hover:text-[var(--color-amber-glow)]">KeepFresh</a>,
            an iOS app working to end food waste for good, and{" "}
            <a href="/onair" class="text-[var(--color-text-bright)] hover:text-[var(--color-amber-glow)]">On Air</a>,
            push-to-talk dictation for Mac.
          </p>
        </div>
      </div>

      <div class="mt-12 flex flex-wrap gap-3">
        <a
          href="https://stravastitch.com"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 border border-[var(--color-amber-dim)] bg-[rgba(232,154,60,0.06)] px-5 py-3 font-mono text-xs uppercase tracking-hud text-[var(--color-amber)] hover:bg-[rgba(232,154,60,0.12)] hover:text-[var(--color-amber-glow)]"
        >
          <span>VISIT STRAVASTITCH.COM</span><span aria-hidden="true">↗</span>
        </a>
        <a
          href="https://github.com/barclayd/strava-stitch"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 border border-[var(--color-rule-strong)] px-5 py-3 font-mono text-xs uppercase tracking-hud text-[var(--color-mute)] hover:text-[var(--color-amber-glow)]"
        >
          <span>GITHUB</span><span aria-hidden="true">↗</span>
        </a>
      </div>
    </HudFrame>

    <SubPageFooter />
  </main>
</Base>
