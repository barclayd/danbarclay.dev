---
import Base from "../layouts/Base.astro";
import Cta from "../components/Cta.astro";
import PageIntro from "../components/PageIntro.astro";
import projectsRaw from "../data/projects.json";
import { PRODUCT_LIST, buildProjects, shotFor } from "../lib/products";
import type { Project } from "../lib/types";

const title = "Work - Dan Barclay · Selected projects shipped publicly";
const description =
  "Selected work by Dan Barclay - engineering leader in London. Including Promptly (LLM prompt CMS, 100+ companies), KeepFresh (iOS app, 77K+ downloads), Stitch (free Strava ride-combining web app), On Air (free-forever Wispr Flow alternative for Mac) and open-source side projects.";

const PERSON_ID = "https://danbarclay.dev/#person";

// Per-project schema - each is a SoftwareApplication / MobileApplication whose
// creator and author are the Person entity declared on the home page.
const workSchema = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "@id": "https://danbarclay.dev/promptly#app",
    name: "Promptly",
    alternateName: "Promptly CMS",
    url: "https://promptlycms.com",
    applicationCategory: "DeveloperApplication",
    operatingSystem: "Web",
    description:
      "A B2B SaaS CMS for LLM prompts. Hands prompt authoring back to the domain experts who write them - versioning, releasing and shipping prompts without a code deploy. Used in production by 100+ companies.",
    creator: { "@id": PERSON_ID },
    author: { "@id": PERSON_ID },
    publisher: { "@id": PERSON_ID },
  },
  {
    "@context": "https://schema.org",
    "@type": "MobileApplication",
    "@id": "https://danbarclay.dev/keepfresh#app",
    name: "KeepFresh",
    url: "https://keepfre.sh",
    applicationCategory: "LifestyleApplication",
    operatingSystem: "iOS",
    description:
      "An iOS app that helps households end food waste by tracking grocery inventory and surfacing expiry alerts. 77,000+ downloads, used daily by hundreds of households.",
    creator: { "@id": PERSON_ID },
    author: { "@id": PERSON_ID },
    publisher: { "@id": PERSON_ID },
  },
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "@id": "https://danbarclay.dev/stitch#app",
    name: "Stitch",
    alternateName: "Strava Stitch",
    url: "https://stravastitch.com",
    applicationCategory: "SportsApplication",
    operatingSystem: "Web",
    description:
      "A free web app that combines two or more split Strava rides into a single activity. Preview the route and gaps, download a merged GPX and backups, then explicitly confirm the upload. Never deletes activities.",
    offers: { "@type": "Offer", price: "0", priceCurrency: "GBP" },
    creator: { "@id": PERSON_ID },
    author: { "@id": PERSON_ID },
    publisher: { "@id": PERSON_ID },
  },
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "@id": "https://danbarclay.dev/onair#app",
    name: "On Air",
    alternateName: "OnAir",
    url: "https://useonair.app",
    applicationCategory: "UtilitiesApplication",
    operatingSystem: "macOS",
    description:
      "A tasteful, free-forever alternative to Wispr Flow for Mac, built for developers who want to ramp up their AI-driven coding throughput with voice transcription. Hold fn, speak and let go - the transcript is pasted into the text field you were typing in, with a soft red glow as the only interface.",
    offers: { "@type": "Offer", price: "0", priceCurrency: "GBP" },
    creator: { "@id": PERSON_ID },
    author: { "@id": PERSON_ID },
    publisher: { "@id": PERSON_ID },
  },
];

const bands = PRODUCT_LIST.map((p) => ({ ...p, img: shotFor(p.key, "bg") }));
const repos = buildProjects(projectsRaw as Project[]);
---

<Base
  title={title}
  description={description}
  pageType="CollectionPage"
  jsonLd={workSchema}
  active="work"
  breadcrumbs={[
    { name: "Home", url: "/" },
    { name: "Work" },
  ]}
>
  <!-- ====== Intro ====== -->
  <PageIntro
    eyebrow="Work"
    title="Four products."
    dim="All live."
    lead="Built and operated end to end, alongside the libraries, backends and yearly traditions that support them."
    tall
  >
    <nav aria-label="On this page">
      <ul class="intro__jumps" data-stagger="70" data-delay="1000">
        {
          bands.map((p) => (
            <li data-reveal="up">
              <a href={`#${p.key}`} style={`--accent:${p.accent}`}>
                <span class="dot intro__dot" aria-hidden="true" />
                {p.name}
              </a>
            </li>
          ))
        }
        <li data-reveal="up"><a href="#repos">Repos ↓</a></li>
      </ul>
    </nav>
  </PageIntro>

  <!-- ====== Product bands ====== -->
  {
    bands.map((p, i) => (
      <section id={p.key} class="band" style={`--accent:${p.accent}`} aria-labelledby={`band-${p.key}`}>
        <div class="band__media" aria-hidden="true" data-reveal="scale" data-dur="2400">
          <div class="band__parallax" data-parallax="0.08">
            {p.img ? (
              <img
                src={p.img}
                alt=""
                width="1920"
                height="1080"
                loading={i ? "lazy" : "eager"}
                decoding="async"
                style={`object-position:${p.shotFocus}`}
              />
            ) : (
              <div class="band__ph" />
            )}
          </div>
        </div>
        <div class="band__scrim" aria-hidden="true" />
        <div class:list={["band__glow", i % 2 ? "is-right" : "is-left"]} aria-hidden="true">
          <div class="glow" style={`--glow-color:${p.accent}`} data-loop="breathe" />
        </div>

        <div class="wrap band__content">
          <span class="eyebrow band__eyebrow" data-reveal="track">
            <span class="dot" aria-hidden="true" />
            {p.n} / 04 · {p.band.category}
          </span>
          <h2 id={`band-${p.key}`} class="band__name" style={`--chars:${p.name.length}`}>
            <span class="line-mask"><span data-reveal="rise">{p.name}</span></span>
          </h2>
          <div class="band__row">
            <p class="band__copy" data-reveal="up" data-delay="120">{p.band.copy}</p>
            <dl class="band__stats" data-stagger="90" data-delay="200">
              {p.band.stats.map(([value, label]) => (
                <div class="band__stat" data-reveal="up">
                  <dt class="stat-label">{label}</dt>
                  <dd class="num band__num">{value}</dd>
                </div>
              ))}
            </dl>
          </div>
          <div class="cta-row" data-stagger="90" data-delay="260">
            <Cta href={p.href} accent={p.accent} data-reveal="up">
              Explore {p.name}
            </Cta>
            <Cta href={p.site} external variant="secondary" data-reveal="up">
              {p.siteLabel} ↗
            </Cta>
          </div>
        </div>
      </section>
    ))
  }

  <!-- ====== Repositories ====== -->
  <section id="repos" class="repos">
    <div class="wrap">
      <div class="section-head">
        <div class="section-head__title">
          <span class="eyebrow" data-reveal="track">Repositories</span>
          <h2 class="h2" data-reveal="up">Shipped in public</h2>
        </div>
        <p class="section-head__copy" data-reveal="up" data-delay="120">
          Every repo behind the products, plus the yearly Advent of Code. Lines show weekly commits over each repo's lifetime.
        </p>
      </div>

      <ul class="repos__list">
        {
          repos.map((r) => (
            <li>
              <a
                class="repo"
                href={r.href}
                style={`--accent:${r.accent}`}
                data-reveal="up"
                {...(r.external ? { target: "_blank", rel: "noopener" } : {})}
              >
                <div class="repo__main">
                  <span class="repo__idx" aria-hidden="true">{r.idx}</span>
                  <div class="repo__text">
                    <span class="repo__name">
                      <span class="dot" aria-hidden="true" />
                      {r.name}
                    </span>
                    <span class="repo__desc">{r.desc}</span>
                  </div>
                </div>
                <dl class="repo__stats">
                  <div>
                    <dt class="stat-label">Commits</dt>
                    <dd class="repo__num">{r.commits}</dd>
                  </div>
                  <div>
                    <dt class="stat-label">Years</dt>
                    <dd class="repo__num">{r.years}</dd>
                  </div>
                  <div>
                    <dt class="stat-label">Language</dt>
                    <dd class="repo__num">{r.language}</dd>
                  </div>
                </dl>
                <div class="repo__chart">
                  <svg viewBox="0 0 300 60" preserveAspectRatio="none" aria-hidden="true">
                    <path d={r.area} class="repo__area" />
                    <path d={r.line} class="repo__line" pathLength="1" data-reveal="draw" />
                  </svg>
                  <span class="repo__arrow" aria-hidden="true">{r.external ? "↗" : "→"}</span>
                  {r.external && <span class="sr-only-seo">(opens GitHub in a new tab)</span>}
                </div>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<style>
  /* ---- Intro jump links (slotted into PageIntro) ---- */
  .intro__jumps {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 28px;
  }

  .intro__jumps a {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 32px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-ink-3);
    transition: color 0.3s;
  }

  .intro__jumps a:hover {
    color: var(--color-ink-hi);
  }

  .intro__dot {
    width: 6px;
    height: 6px;
    box-shadow: 0 0 10px var(--accent);
  }

  /* ---- Bands ---- */
  .band {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: 92svh;
    overflow: hidden;
  }

  .band__media {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .band__parallax {
    position: absolute;
    top: -8%;
    bottom: -8%;
    left: 0;
    right: 0;
    opacity: 0.7;
  }

  .band__parallax img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .band__ph {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(70% 60% at 72% 30%, color-mix(in oklch, var(--accent) 34%, transparent), transparent 70%),
      linear-gradient(rgba(255, 255, 255, 0.05) 1px, transparent 1px) 0 0 / 100% 12.5%,
      linear-gradient(90deg, rgba(255, 255, 255, 0.05) 1px, transparent 1px) 0 0 / 6.25% 100%;
  }

  .band__scrim {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(0deg, #08090b 0%, rgba(8, 9, 11, 0.75) 32%, rgba(8, 9, 11, 0) 70%);
  }

  .band__glow {
    position: absolute;
    bottom: -45vw;
    width: 85vw;
    height: 85vw;
    opacity: 0.24;
    pointer-events: none;
  }

  .band__glow.is-left {
    left: -25vw;
  }

  .band__glow.is-right {
    right: -25vw;
  }

  .band__glow > .glow {
    inset: 0;
  }

  .band__content {
    position: relative;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding-bottom: clamp(48px, 9vh, 96px);
  }

  .band__eyebrow {
    gap: 12px;
    color: var(--color-ink-3);
  }

  /* Fitted to the line so long names never overflow a phone. */
  .band__name {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: min(clamp(40px, 9vw, 168px), calc((100vw - 2 * clamp(20px, 4vw, 64px)) / var(--chars) / 0.96));
    line-height: 1;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .band__row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 28px 48px;
  }

  .band__copy {
    max-width: 520px;
    font-size: clamp(16px, 1.3vw, 19px);
    line-height: 1.6;
    color: var(--color-ink-2);
    text-wrap: pretty;
  }

  .band__stats {
    display: flex;
    gap: 40px;
  }

  .band__stat {
    display: flex;
    flex-direction: column-reverse;
    gap: 10px;
  }

  .band__num {
    font-size: clamp(34px, 3.4vw, 52px);
  }

  @media (max-width: 639px) {
    .band__content {
      gap: 22px;
      padding-bottom: max(40px, env(safe-area-inset-bottom));
    }

    .band__copy {
      font-size: 16px;
    }

    .band__stats {
      width: 100%;
      gap: 32px;
    }
  }

  /* ---- Repositories ---- */
  .repos {
    padding: clamp(120px, 20vh, 240px) 0 clamp(120px, 18vh, 200px);
  }

  .repos__list {
    border-top: 1px solid var(--color-line-3);
  }

  .repo {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 20px 40px;
    padding: 30px 4px;
    border-bottom: 1px solid var(--color-line-2);
    transition: background-color 0.4s;
  }

  .repo:hover {
    background: rgba(255, 255, 255, 0.03);
  }

  .repo__main {
    display: flex;
    align-items: baseline;
    gap: 20px;
    flex: 1 1 380px;
    min-width: 0;
  }

  .repo__idx {
    font-size: 12px;
    letter-spacing: 0.1em;
    color: var(--color-label);
    font-variant-numeric: tabular-nums;
  }

  .repo__text {
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 0;
  }

  .repo__name {
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-display);
    font-size: clamp(15px, 1.5vw, 20px);
    letter-spacing: 0.04em;
    overflow-wrap: anywhere;
  }

  .repo__desc {
    font-size: 15px;
    line-height: 1.5;
    color: var(--color-muted);
    text-wrap: pretty;
  }

  .repo__stats {
    display: flex;
    gap: 36px;
    flex: 0 0 auto;
  }

  .repo__stats > div {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .repo__stats .stat-label {
    color: var(--color-label);
  }

  .repo__num {
    font-stretch: 115%;
    font-weight: 250;
    font-size: 26px;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .repo__chart {
    flex: 1 1 220px;
    min-width: 180px;
    height: 56px;
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .repo__chart svg {
    flex: 1;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .repo__area {
    fill: var(--accent);
    fill-opacity: 0.1;
  }

  .repo__line {
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.5;
    stroke-linejoin: round;
    stroke-dasharray: 1;
    vector-effect: non-scaling-stroke;
  }

  .repo__arrow {
    flex: none;
    font-size: 18px;
    color: var(--color-ink-3);
    transition: transform 0.4s var(--ease-out-expo);
  }

  .repo:hover .repo__arrow {
    transform: translate3d(4px, 0, 0);
  }

  /* Phones: the index drops out and the stats share the row evenly. */
  @media (max-width: 639px) {
    .repo {
      gap: 22px;
      padding: 26px 0;
    }

    .repo__main {
      flex-basis: 100%;
    }

    .repo__idx {
      display: none;
    }

    .repo__stats {
      flex: 1 1 100%;
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 16px;
    }

    .repo__stats .stat-label {
      font-size: 10px;
      letter-spacing: 0.14em;
    }

    .repo__num {
      font-size: 22px;
    }

    .repo__chart {
      flex-basis: 100%;
      height: 48px;
    }
  }
</style>
