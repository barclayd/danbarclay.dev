---
import Base from "../layouts/Base.astro";
import HudFrame from "../components/HudFrame.astro";
import SubPageHeader from "../components/SubPageHeader.astro";
import SubPageFooter from "../components/SubPageFooter.astro";
import { posts } from "../data/posts";

const SITE_URL = "https://danbarclay.dev";
const PERSON_ID = SITE_URL + "/#person";
const title = "Blog · Dan Barclay";
const description =
  "Writing by Dan Barclay, engineering leader and founder in London: field reports on applied AI, evaluation and shipping product.";
const date = (iso: string) =>
  new Date(iso).toLocaleDateString("en-GB", { day: "2-digit", month: "short", year: "numeric" }).toUpperCase();

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Blog",
    "@id": SITE_URL + "/blog#blog",
    name: "Dan Barclay · Blog",
    url: SITE_URL + "/blog",
    description,
    author: { "@id": PERSON_ID },
    publisher: { "@id": PERSON_ID },
    blogPost: posts.map((p) => ({ "@id": `${SITE_URL}/blog/${p.slug}#post` })),
  },
];
---

<Base
  title={title}
  description={description}
  pageType="CollectionPage"
  jsonLd={schema}
  breadcrumbs={[{ name: "Home", url: "/" }, { name: "Blog" }]}
>
  <main
    class="mx-auto flex w-full max-w-[1100px] flex-col gap-12 py-10 sm:gap-16 sm:py-14 lg:gap-20 pl-[max(1rem,env(safe-area-inset-left))] pr-[max(1rem,env(safe-area-inset-right))] sm:pl-[max(2rem,env(safe-area-inset-left))] sm:pr-[max(2rem,env(safe-area-inset-right))] lg:pl-[max(3rem,env(safe-area-inset-left))] lg:pr-[max(3rem,env(safe-area-inset-right))]"
  >
    <SubPageHeader current="blog" />

    <HudFrame label="BLOG" index={String(posts.length).padStart(2, "0")} className="px-6 py-10 sm:px-10 sm:py-14">
      <div class="mb-4 flex items-center gap-2 font-mono text-[10px] uppercase tracking-hud text-[var(--color-mute)]">
        <span class="h-px w-6 bg-[var(--color-amber)]"></span>
        <span>WRITING · BY DAN BARCLAY</span>
      </div>
      <h1
        class="font-display font-semibold uppercase leading-[0.95] tracking-tight text-[var(--color-text-bright)]"
        style="font-size: clamp(2.5rem, 9vw, 5rem);"
      >
        Blog
      </h1>
      <p class="mt-6 max-w-2xl font-display text-base leading-relaxed text-[var(--color-mute)] sm:text-lg">
        Field reports from building things: what worked, what didn't, and the numbers behind both.
      </p>

      <div class="my-10 h-px w-full bg-[var(--color-rule)]"></div>

      <ol class="divide-y divide-[var(--color-rule)] border-y border-[var(--color-rule)]">
        {posts.map((p, i) => (
          <li>
            <a href={`/blog/${p.slug}`} class="group grid gap-3 py-8 sm:grid-cols-[9rem_1fr] sm:gap-8">
              <div class="font-mono text-[10px] uppercase tracking-hud text-[var(--color-mute)]">
                <div class="text-[var(--color-amber)]">{String(i + 1).padStart(2, "0")}</div>
                <time datetime={p.published} class="mt-1 block">{date(p.published)}</time>
                <div class="mt-1">{p.readingMinutes} MIN READ</div>
              </div>
              <div>
                <h2 class="font-display text-2xl font-semibold uppercase tracking-tight text-[var(--color-text-bright)] transition-colors group-hover:text-[var(--color-amber-glow)] sm:text-3xl">
                  {p.title} <span aria-hidden="true" class="text-[var(--color-amber)]">→</span>
                </h2>
                <p class="mt-3 max-w-2xl font-display text-base leading-relaxed text-[var(--color-text)]">{p.subtitle}</p>
                <ul class="mt-4 flex flex-wrap gap-2">
                  {p.tags.map((t) => (
                    <li class="border border-[var(--color-rule-strong)] px-2 py-0.5 font-mono text-[9px] uppercase tracking-hud text-[var(--color-mute)]">{t}</li>
                  ))}
                </ul>
              </div>
            </a>
          </li>
        ))}
      </ol>
    </HudFrame>

    <SubPageFooter />
  </main>
</Base>
